      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Storage</string>
          <string name="Source"><![CDATA[--!strict
-- All live writes fail closed. The simulation implements the same CAS contract.
local Storage = {}

local function clone(value)
	if type(value) ~= "table" then return value end
	local result = {}
	for key, item in pairs(value) do result[key] = clone(item) end
	return result
end
Storage.clone = clone

-- Canonical keys are discoverable without a secondary registration write.
-- Sixteen prefixes allow independent bounded recovery walks in live servers.
function Storage.partitionFor(id, partitions)
	local value = 0
	for index = 1, #id do value = (value * 33 + string.byte(id, index)) % (partitions or 16) end
	return value + 1
end

function Storage.createSimulation(options)
	options = options or {}
	local backend = { simulation = true, recoveryPartitions = options.partitions or 1, profiles = {}, monsters = {}, hints = {}, online = {}, leases = {}, checkpoints = {}, failures = {} }
	local function guard(name)
		local count = backend.failures[name] or 0
		if count > 0 then backend.failures[name] = count - 1; error("Simulated storage failure: " .. name) end
	end
	function backend:failNext(name, count) self.failures[name] = count or 1 end
	function backend:getProfile(id) guard("getProfile"); return clone(self.profiles[tostring(id)]) end
	function backend:updateProfile(id, transform)
		guard("updateProfile")
		id = tostring(id)
		local result = transform(clone(self.profiles[id]))
		if result == nil then return nil end
		self.profiles[id] = clone(result)
		return clone(result)
	end
	function backend:getMonster(id) guard("getMonster"); return clone(self.monsters[id]) end
	function backend:updateMonster(id, transform)
		guard("updateMonster")
		local result = transform(clone(self.monsters[id]))
		if result == nil then return nil end
		self.monsters[id] = clone(result)
		return clone(result)
	end
	function backend:createMonster(record)
		return self:updateMonster(record.id, function(old) return old or clone(record) end)
	end
	function backend:listMonsterIds(cursor, limit, partition)
		guard("listMonsterIds")
		local keys = {}
		for key in pairs(self.monsters) do
			if (not cursor or key > cursor) and (not partition or Storage.partitionFor(key, self.recoveryPartitions) == partition) then table.insert(keys, key) end
		end
		table.sort(keys)
		local result = {}
		for index = 1, math.min(limit or 20, #keys) do table.insert(result, keys[index]) end
		return result, if #keys > #result then result[#result] else nil
	end
	function backend:presence(id, value, now)
		guard("presence")
		if value then self.online[tostring(id)] = { value = clone(value), expires = now + 90 } else self.online[tostring(id)] = nil end
	end
	function backend:listPresence(now)
		guard("listPresence")
		local values = {}
		for id, entry in pairs(self.online) do if entry.expires > now then table.insert(values, { id = id, value = clone(entry.value) }) end end
		return values
	end
	function backend:enqueue(id, now) guard("enqueue"); self.hints[id] = now end
	function backend:removeHint(id) self.hints[id] = nil end
	function backend:listHints(limit)
		guard("listHints")
		local values = {}
		for id in pairs(self.hints) do table.insert(values, id) end
		table.sort(values)
		while #values > (limit or 20) do table.remove(values) end
		return values
	end
	function backend:lease(name, owner, now, seconds)
		local old = self.leases[name]
		if old and old.expires > now and old.owner ~= owner then return false end
		self.leases[name] = { owner = owner, expires = now + seconds }
		return true
	end
	function backend:getCheckpoint(name) return clone(self.checkpoints[name]) end
	function backend:setCheckpoint(name, value) guard("setCheckpoint"); self.checkpoints[name] = clone(value) end
	function backend:hasBudget() return true end
	function backend:reset()
		self.profiles = {}; self.monsters = {}; self.hints = {}; self.online = {}; self.leases = {}; self.checkpoints = {}; self.failures = {}
	end
	return backend
end

function Storage.createLive(options)
	options = options or {}
	local dataService = game:GetService("DataStoreService")
	local memoryService = game:GetService("MemoryStoreService")
	local namespace = options.namespace or "MAM_v1"
	assert(namespace:match("^[%w_%-]+$") and #namespace <= 32, "Invalid storage namespace")
	local records = dataService:GetDataStore(namespace .. "_Records")
	local profiles = dataService:GetDataStore(namespace .. "_Profiles")
	local recovery = dataService:GetDataStore(namespace .. "_Recovery")
	local presence = memoryService:GetSortedMap(namespace .. "_Presence")
	local queue = memoryService:GetSortedMap(namespace .. "_Queue")
	local leases = memoryService:GetSortedMap(namespace .. "_Leases")
	local backend = { simulation = false, namespace = namespace, recoveryPartitions = 16 }
	local function recordPrefix(partition) return string.format("m:%02x:", partition - 1) end
	local function recordKey(id) return recordPrefix(Storage.partitionFor(id, 16)) .. id end
	local function request(label, fn)
		local lastError
		for attempt = 1, 3 do
			local ok, value = pcall(fn)
			if ok then return value end
			lastError = tostring(value)
			if attempt < 3 then task.wait(0.3 * 2 ^ (attempt - 1) + math.random() * 0.2) end
		end
		warn("MAIL A MONSTER storage operation paused: " .. label)
		error("Storage is temporarily unavailable. Please retry. [" .. label .. "] " .. tostring(lastError), 0)
	end
	function backend:getProfile(id) return request("profile read", function() return profiles:GetAsync("p:" .. tostring(id)) end) end
	function backend:updateProfile(id, transform) return request("profile update", function() return profiles:UpdateAsync("p:" .. tostring(id), transform) end) end
	function backend:getMonster(id) return request("monster read", function() return records:GetAsync(recordKey(id)) end) end
	function backend:updateMonster(id, transform) return request("monster update", function() return records:UpdateAsync(recordKey(id), transform) end) end
	function backend:createMonster(record) return self:updateMonster(record.id, function(old) return old or clone(record) end) end
	function backend:listMonsterIds(cursor, limit, partition)
		return request("enumeration", function()
			local prefix = if partition then recordPrefix(partition) else "m:"
			local pages = records:ListKeysAsync(prefix, limit or 12, cursor or "", true)
			local ids = {}
			for _, entry in ipairs(pages:GetCurrentPage()) do table.insert(ids, string.sub(entry.KeyName, 6)) end
			return { ids, if pages.IsFinished or pages.Cursor == "" then nil else pages.Cursor }
		end)
	end
	-- The live list wrapper preserves both result values across pcall retries.
	local enumerate = backend.listMonsterIds
	function backend:listMonsterIds(cursor, limit, partition)
		local result = enumerate(self, cursor, limit, partition)
		return result[1], result[2]
	end
	function backend:presence(id, value, now)
		return request("presence", function()
			if value then presence:SetAsync(tostring(id), value, 90, math.random()) else presence:RemoveAsync(tostring(id)) end
		end)
	end
	function backend:listPresence(now)
		return request("presence sampling", function()
			local entries = presence:GetRangeAsync(Enum.SortDirection.Descending, 100)
			local result = {}
			for _, entry in ipairs(entries) do table.insert(result, { id = entry.key, value = entry.value }) end
			return result
		end)
	end
	function backend:enqueue(id, now) return request("queue hint", function() queue:SetAsync(id, true, 3600, now) end) end
	function backend:removeHint(id) return request("queue removal", function() queue:RemoveAsync(id) end) end
	function backend:listHints(limit)
		return request("queue sampling", function()
			local result = {}
			for _, entry in ipairs(queue:GetRangeAsync(Enum.SortDirection.Ascending, limit or 12)) do table.insert(result, entry.key) end
			return result
		end)
	end
	function backend:lease(name, owner, now, seconds)
		local result = request("worker lease", function()
			return leases:UpdateAsync(name, function(old)
				if old and old.expires > now and old.owner ~= owner then return old end
				return { owner = owner, expires = now + seconds }
			end, seconds + 5)
		end)
		return result and result.owner == owner
	end
	function backend:getCheckpoint(name) return request("checkpoint read", function() return recovery:GetAsync(name) end) end
	function backend:setCheckpoint(name, value) return request("checkpoint update", function() return recovery:UpdateAsync(name, function() return value end) end) end
	function backend:hasBudget(minReads, minUpdates)
		return dataService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync) >= (minUpdates or 8)
			and dataService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.GetAsync) >= (minReads or 8)
	end
	return backend
end

return Storage
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">VoyageService</string>
          <string name="Source"><![CDATA[--!strict
-- Durable transitions have one canonical monster record; profiles contain references.
-- Dependencies are injected so this service runs under the standalone Luau VM.
local VoyageService = {}
VoyageService.__index = VoyageService

local function copy(value)
	if type(value) ~= "table" then return value end
	local result = {}; for key, item in pairs(value) do result[key] = copy(item) end; return result
end
local function count(value) local n = 0; for _ in pairs(value or {}) do n += 1 end; return n end
local function contains(values, wanted) for _, value in ipairs(values) do if value == wanted then return true end end; return false end
local function fail(message) error(message, 0) end
local function expect(condition, message) if not condition then fail(message) end end
local function str(value) return type(value) == "string" and #value > 0 and #value <= 100 end

function VoyageService.new(storage, clock, options)
	options = options or {}
	local config = options.config
	local catalog = options.catalog
	if not config then config = require(game:GetService("ReplicatedStorage").MailAMonster.Shared.Config) end
	if not catalog then catalog = require(game:GetService("ReplicatedStorage").MailAMonster.Shared.Catalog) end
	local self = setmetatable({storage = storage, clock = clock, config = config, catalog = catalog, profiles = {}, active = {}, options = options, lastRecovery = -math.huge, lastPresence = -math.huge}, VoyageService)
	self.random = options.random or math.random
	self.newId = options.newId or function() return game:GetService("HttpService"):GenerateGUID(false) end
	self.workerId = options.workerId or self.newId()
	self.recoveryPartition = options.recoveryPartition or self.random(1, storage.recoveryPartitions or 1)
	return self
end

function VoyageService:level(profile) return self.config.level(profile.xp or 0) end

function VoyageService:_defaults(id, createdAt)
	return {schema = self.config.SchemaVersion, id = id, currency = self.config.StartingPostage,
		owned = {}, inbox = {}, outgoing = {}, xp = 0, hatchSeq = 0, pendingHatches = {}, launchReservations = {}, launchFloor = {},
		tutorial = {}, settings = {reducedMotion = false, musicVolume = 0.4, sfxVolume = 0.6, cameraShake = true, shareCountry = false, acceptVisitors = true},
		cosmetics = {["cannon:classic"] = true, ["mailbox:classic"] = true}, placements = {}, displaySlots = {}, cannon = "classic", mailbox = "classic",
		album = {}, stamps = {}, milestones = {}, stats = {forwards = 0, activities = 0, sorting = 0, watering = 0, letters = 0},
		requests = {day = self.config.day(createdAt), counters = {}, claimed = {}},
		receipts = {}, receiptEpoch = 1, caps = {carrier = {}, owner = {}}, capFloor = {carrier = -1, owner = -1}, lastLaunchAt = -1000000}
end

function VoyageService:_migrate(profile, id, createdAt)
	if not profile then return self:_defaults(id, createdAt) end
	expect((profile.schema or 0) <= self.config.SchemaVersion, "This save needs a newer server. Please rejoin.")
	if profile.hatchSeq == nil then profile.hatchSeq = #(profile.owned or {}) end
	local defaults = self:_defaults(id, createdAt)
	for key, value in pairs(defaults) do if profile[key] == nil then profile[key] = copy(value) end end
	for key, value in pairs(defaults.settings) do if profile.settings[key] == nil then profile.settings[key] = value end end
	for key, value in pairs(defaults.stats) do if profile.stats[key] == nil then profile.stats[key] = value end end
	for _, family in ipairs({ "carrier", "owner" }) do
		if profile.caps[family] == nil then profile.caps[family] = {} end
		if profile.capFloor[family] == nil then profile.capFloor[family] = -1 end
	end
	profile.requests.counters = profile.requests.counters or {}
	profile.requests.claimed = profile.requests.claimed or {}
	if profile.tutorial.hatched == nil and #profile.owned > 0 then profile.tutorial.hatched = true end
	profile.schema = self.config.SchemaVersion
	return profile
end

function VoyageService:_newMonster(id, owner, name, seed)
	local catalog = self.catalog
	return {schema = self.config.SchemaVersion, id = id, ownerId = owner, name = name, seed = seed,
		body = catalog.Bodies[seed % #catalog.Bodies + 1], palette = catalog.PaletteOrder[math.floor(seed / 4) % #catalog.PaletteOrder + 1],
		face = catalog.Faces[math.floor(seed / 24) % #catalog.Faces + 1], personality = catalog.Personalities[math.floor(seed / 96) % #catalog.Personalities + 1],
		state = "HOME", version = 1, voyageNumber = 0, lifetimeHops = 0, voyagesCompleted = 0, normalVoyagesCompleted = 0, practiceVoyagesCompleted = 0, slots = {}, earned = {}, books = {}, operations = {}}
end

function VoyageService:_migrateMonster(monster)
	if not monster then return nil end
	expect((monster.schema or 0) <= self.config.SchemaVersion, "This monster needs a newer server. Please rejoin.")
	if monster.schema == self.config.SchemaVersion then return monster end
	expect(str(monster.id) and str(monster.ownerId), "This monster record needs operator recovery.")
	expect(not monster.voyage or monster.state, "An ambiguous active voyage needs operator recovery.")
	local seed = monster.seed or 1
	expect(type(seed) == "number" and seed == seed and seed >= 0 and seed < math.huge, "This monster's cosmetic seed needs operator recovery.")
	local defaults = self:_newMonster(monster.id, monster.ownerId, monster.name or "Gerald", seed)
	for key, value in pairs(defaults) do if monster[key] == nil then monster[key] = copy(value) end end
	monster.schema = self.config.SchemaVersion
	return monster
end

function VoyageService:_readMonster(id)
	local monster = self.storage:getMonster(id)
	if monster and monster.schema ~= self.config.SchemaVersion then
		return self.storage:updateMonster(id, function(current) return self:_migrateMonster(current) end)
	end
	return monster
end

function VoyageService:_recoverHatches(id)
	local profile = self.storage:getProfile(id)
	for monsterId, record in pairs(profile.pendingHatches or {}) do
		local created = self.storage:createMonster(record)
		expect(created and created.ownerId == id, "Hatch recovery needs retry.")
		self.storage:updateProfile(id, function(p) if p and p.pendingHatches[monsterId] then p.pendingHatches[monsterId] = nil end; return p end)
	end
end

function VoyageService:loadPlayer(userId)
	local id = tostring(userId)
	local createdAt = self.clock.now()
	local profile = self.storage:updateProfile(id, function(old) return self:_migrate(old, id, createdAt) end)
	self.active[id] = true
	self:_recoverHatches(id)
	for _, monsterId in ipairs(profile.owned) do self:_process(monsterId) end
	self:_repairInbox(id)
	self:_ensureTutorialVisitor(id)
	self:_presence(id)
	return self:snapshot(id)
end

function VoyageService:_presence(id, profile)
	profile = profile or self.storage:getProfile(id)
	if profile then self.storage:presence(id, {accept = profile.settings.acceptVisitors, available = math.max(0, self.config.IncomingCapacity - count(profile.inbox)), job = self.options.jobId or self.workerId}, self.clock.now()) end
end

function VoyageService:playerLeaving(userId)
	local id = tostring(userId); self.active[id] = nil; self.profiles[id] = nil
	self.storage:presence(id, nil, self.clock.now())
end

function VoyageService:_ensureTutorialVisitor(id)
	local p = self.storage:getProfile(id)
	if not p or not p.tutorial.hatched or p.tutorial.visitor or p.tutorial.skipped then return end
	local monsterId = "tutorial-" .. id
	local now = self.clock.now()
	local monster = self:_newMonster(monsterId, "NPC", "Pickle", 11)
	monster.tutorialFor = id; monster.state = "HELD"; monster.voyageNumber = 1
	monster.voyage = {id = monsterId .. ":1", plan = "Tutorial", practice = true, tutorial = true, startedAt = now, deadline = now + 365 * 86400, hopTarget = 0, deposit = 0,
		humanHops = 0, rewardHops = 0, visited = {}, events = {{kind = "NPC", at = now, label = "NPC tutorial visitor — help Pickle learn the post!"}},
		slotsBefore = {}, holderId = id, claimToken = monsterId .. ":claim", holdUntil = now + 365 * 86400, npcCount = 0, lastNpcAt = now}
	self.storage:createMonster(monster)
	self.storage:updateProfile(id, function(profile)
		if profile and not profile.tutorial.visitor and count(profile.inbox) < self.config.IncomingCapacity then
			profile.inbox[monsterId] = {token = monster.voyage.claimToken, voyageId = monster.voyage.id, expires = monster.voyage.holdUntil}
		end
		return profile
	end)
end

function VoyageService:_hatch(id, payload)
	expect(contains(self.catalog.Names, payload.name), "Choose a name from the list.")
	expect(type(payload.sequence) == "number" and payload.sequence >= 0 and payload.sequence % 1 == 0, "Refresh your hatchery before hatching.")
	local newId = self.newId(); local seed = self.random(1, 1000000)
	local record = self:_newMonster(newId, id, payload.name, seed)
	local result = self.storage:updateProfile(id, function(p)
		if not p or p.hatchSeq ~= payload.sequence or next(p.pendingHatches) or #p.owned >= self.config.MaxOwnedMonsters then return nil end
		local price = if p.tutorial.hatched then self.config.EggCost else 0
		if p.currency < price then return nil end
		p.currency -= price; p.hatchSeq += 1; p.tutorial.hatched = true
		p.pendingHatches[newId] = copy(record); table.insert(p.owned, newId)
		return p
	end)
	expect(result and result.pendingHatches[newId], "The egg was already hatched, your collection is full, or you need more Postage. Refresh your collection before retrying.")
	self:_recoverHatches(id); self:_ensureTutorialVisitor(id)
	return {kind = "hatch", monsterId = newId}
end

function VoyageService:_launch(id, payload)
	expect(str(payload.monsterId), "Choose a monster.")
	local plan = self.config.Plans[payload.plan]
	expect(plan, "Choose a valid voyage plan.")
	local objective = payload.objective or "hat"
	expect(self.config.Objectives[objective], "Choose a valid voyage objective.")
	local now = self.clock.now()
	local profile = self.storage:getProfile(id)
	expect(profile and self:level(profile) >= plan.level, "This voyage unlocks at a higher courier level.")
	local current = self:_readMonster(payload.monsterId)
	expect(current and current.ownerId == id, "That monster is not in your collection.")
	if current.state == "LAUNCH_PENDING" then
		expect(current.launchVersion == payload.version + 1, "This launch request belongs to an older monster state. Refresh your collection.")
		self:_process(current.id)
		local recovered = self.storage:getMonster(current.id)
		expect(recovered and recovered.voyage and recovered.state ~= "HOME" and recovered.state ~= "LAUNCH_PENDING", "Launch reservation could not complete. Please retry.")
		return {kind = "launch", monsterId = current.id}
	end
	self:_drain(current.id); current = self.storage:getMonster(current.id)
	expect(current.version == payload.version, "That launch was already accepted or the monster changed. Refresh before planning another voyage.")
	expect(count(current.operations) == 0, "Your previous homecoming is still settling. Please retry.")
	expect(current.state == "HOME", "Your monster is already traveling.")
	expect(not plan.practice or not profile.tutorial.practice, "Your practice voyage is already complete.")
	local operation = "launch:" .. current.id .. ":" .. (current.version + 1)
	local voyage = {id = current.id .. ":" .. (current.voyageNumber + 1), plan = plan.id, practice = plan.practice == true, startedAt = now,
		deadline = now + plan.seconds, hopTarget = plan.hops, deposit = plan.cost, humanHops = 0, rewardHops = 0, visited = {},
		events = {{kind = "DEPARTURE", at = now, label = if plan.practice then "Practice Voyage — fictional NPC postal route" else "Departure from home"}},
		slotsBefore = copy(current.slots), npcCount = 0, lastNpcAt = now, objective = objective}
	local prepared = self.storage:updateMonster(current.id, function(m)
		if not m or m.ownerId ~= id or m.state ~= "HOME" or m.version ~= current.version or count(m.operations) > 0 then return nil end
		m.state = "LAUNCH_PENDING"; m.version += 1; m.voyage = copy(voyage); m.launchOperation = operation; m.launchVersion = m.version; m.launchCancelled = nil
		return m
	end)
	expect(prepared and prepared.launchOperation == operation, "The monster changed. Please retry.")
	self:_process(current.id)
	local accepted = self.storage:getMonster(current.id)
	expect(accepted and accepted.voyage and accepted.voyage.id == voyage.id and accepted.state ~= "HOME" and accepted.state ~= "LAUNCH_PENDING", "Launch could not reserve Postage or an outgoing slot. Please retry.")
	return {kind = "launch", monsterId = current.id}
end

function VoyageService:_cancelLaunch(monster)
	local operation = monster.launchOperation
	self.storage:updateProfile(monster.ownerId, function(p)
		if not p then return nil end
		p.launchFloor[monster.id] = math.max(p.launchFloor[monster.id] or 0, monster.launchVersion)
		local reservation = p.launchReservations[operation]
		if reservation and reservation.status == "reserved" then p.currency += reservation.amount end
		p.launchReservations[operation] = nil
		if p.outgoing[monster.id] == operation then p.outgoing[monster.id] = nil end
		if p.practiceActive == operation then p.practiceActive = nil end
		return p
	end)
	self.storage:updateMonster(monster.id, function(m)
		if m and m.state == "LAUNCH_PENDING" and m.launchOperation == operation and m.launchCancelled then
			m.state = "HOME"; m.version += 1; m.voyage = nil; m.launchOperation = nil; m.launchCancelled = nil
		end
		return m
	end)
end

function VoyageService:_prepareLaunch(monster)
	local operation, owner = monster.launchOperation, monster.ownerId
	if monster.launchCancelled then self:_cancelLaunch(monster); return end
	local now = self.clock.now()
	local p = self.storage:updateProfile(owner, function(profile)
		if not profile then return nil end
		if (profile.launchFloor[monster.id] or 0) >= monster.launchVersion then return profile end
		if profile.launchReservations[operation] then return profile end
		local capacity = self.config.OutgoingCapacity + (if self:level(profile) >= self.config.ExtraOutgoingLevel then 1 else 0)
		if monster.voyage.practice and (profile.practiceActive or profile.tutorial.practice) then return profile end
		if count(profile.outgoing) >= capacity or profile.currency < monster.voyage.deposit or now - profile.lastLaunchAt < self.config.DispatchCooldown then return profile end
		profile.currency -= monster.voyage.deposit; profile.lastLaunchAt = now
		profile.launchReservations[operation] = {amount = monster.voyage.deposit, monsterId = monster.id, status = "reserved"}
		profile.outgoing[monster.id] = operation
		if monster.voyage.practice then profile.practiceActive = operation end
		return profile
	end)
	if not p or not p.launchReservations[operation] then
		local cancelled = self.storage:updateMonster(monster.id, function(m)
			if m and m.state == "LAUNCH_PENDING" and m.launchOperation == operation then m.launchCancelled = true end
			return m
		end)
		if cancelled and cancelled.launchCancelled then self:_cancelLaunch(cancelled) end
		return
	end
	local queued = self.storage:updateMonster(monster.id, function(m)
		if not m or m.launchOperation ~= operation then return nil end
		if m.state == "LAUNCH_PENDING" and not m.launchCancelled then m.state = "QUEUED"; m.version += 1; m.voyageNumber += 1 end
		return m
	end)
	if queued and queued.launchCancelled then self:_cancelLaunch(queued); return end
	if not queued or not queued.voyage or queued.state == "LAUNCH_PENDING" then return end
	self.storage:updateProfile(owner, function(profile)
		local reservation = profile and profile.launchReservations[operation]
		if reservation and reservation.status == "reserved" then reservation.status = "finalized" end
		return profile
	end)
	self.storage:enqueue(monster.id, now)
end

function VoyageService:_repairInbox(id)
	local profile = self.storage:getProfile(id)
	if not profile then return end
	local now = self.clock.now()
	for monsterId, reference in pairs(profile.inbox) do
		local m = self.storage:getMonster(monsterId)
		local valid = m and m.state == "HELD" and m.voyage and m.voyage.holderId == id and m.voyage.claimToken == reference.token
		-- Fresh reservations remain until their claimant finishes or timeout; do not race it.
		if not valid and (reference.expires or 0) <= now then
			self.storage:updateProfile(id, function(p)
				if p and p.inbox[monsterId] and p.inbox[monsterId].token == reference.token then p.inbox[monsterId] = nil end
				return p
			end)
		end
	end
end

function VoyageService:_match(monster)
	if monster.state ~= "QUEUED" or monster.voyage.practice then return false end
	local now = self.clock.now()
	local entries = self.storage:listPresence(now)
	for i = #entries, 2, -1 do local j = self.random(1, i); entries[i], entries[j] = entries[j], entries[i] end
	for _, entry in ipairs(entries) do
		local id = entry.id
		if id ~= monster.ownerId and not monster.voyage.visited[id] and entry.value.accept and entry.value.available > 0 then
			local token = self.newId()
			local reserve = self.storage:updateProfile(id, function(p)
				if not p or not p.settings.acceptVisitors or count(p.inbox) >= self.config.IncomingCapacity or p.inbox[monster.id] then return nil end
				p.inbox[monster.id] = {token = token, voyageId = monster.voyage.id, expires = now + 60}
				return p
			end)
			if reserve and reserve.inbox[monster.id] and reserve.inbox[monster.id].token == token then
				local held = self.storage:updateMonster(monster.id, function(m)
					if not m or m.state ~= "QUEUED" or m.version ~= monster.version or m.voyage.id ~= monster.voyage.id or m.voyage.deadline <= now or m.voyage.visited[id] then return nil end
					m.state = "HELD"; m.version += 1; m.voyage.holderId = id; m.voyage.claimToken = token; m.voyage.holdUntil = math.min(now + self.config.HoldSeconds, m.voyage.deadline)
					return m
				end)
				if held and held.state == "HELD" and held.voyage.claimToken == token then
					self.storage:updateProfile(id, function(p) if p and p.inbox[monster.id] and p.inbox[monster.id].token == token then p.inbox[monster.id].expires = held.voyage.holdUntil end; return p end)
					self.storage:removeHint(monster.id)
					return true
				end
				self:_removeInbox(id, monster.id, token)
			end
		end
	end
	return false
end

function VoyageService:_removeInbox(id, monsterId, token)
	self.storage:updateProfile(id, function(p) if p and p.inbox[monsterId] and p.inbox[monsterId].token == token then p.inbox[monsterId] = nil end; return p end)
end

function VoyageService:_repairHeld(monster)
	local v = monster.voyage
	if monster.state ~= "HELD" or not v or v.holdUntil <= self.clock.now() then return end
	local profile = self.storage:getProfile(v.holderId)
	if not profile then return end
	local existing = profile.inbox[monster.id]
	if existing and existing.token == v.claimToken then return end
	local reservationExpiry = self.clock.now() + 60
	local repaired = self.storage:updateProfile(v.holderId, function(p)
		if not p then return nil end
		local ref = p.inbox[monster.id]
		if ref and ref.token == v.claimToken then return p end
		if ref or count(p.inbox) >= self.config.IncomingCapacity then return nil end
		p.inbox[monster.id] = { token = v.claimToken, voyageId = v.id, expires = reservationExpiry }
		return p
	end)
	if repaired and repaired.inbox[monster.id] and repaired.inbox[monster.id].token == v.claimToken then return end
	if v.tutorial then return end
	-- A reservation may expire before a delayed canonical claim commits. If its
	-- slot has since filled, revoke that exact claim and put the traveler back.
	self.storage:updateMonster(monster.id, function(m)
		if not m or m.state ~= "HELD" or m.version ~= monster.version or not m.voyage
			or m.voyage.claimToken ~= v.claimToken then return nil end
		m.operations["release:" .. v.claimToken] = { kind = "inbox", target = v.holderId, token = v.claimToken }
		m.voyage.holderId = nil; m.voyage.claimToken = nil; m.voyage.holdUntil = nil
		m.state = "QUEUED"; m.version += 1
		return m
	end)
end

function VoyageService:_forward(id, payload, release)
	expect(str(payload.monsterId) and str(payload.voyageId) and type(payload.version) == "number", "That visitor request is invalid.")
	local profile = self.storage:getProfile(id)
	local ref = profile and profile.inbox[payload.monsterId]
	expect(ref, "This visitor has already moved on. Refresh your mailbox.")
	local souvenir = self.catalog.Souvenirs[payload.souvenirId]
	if not release then expect(souvenir and self:level(profile) >= souvenir.level, "Choose an unlocked souvenir.") end
	local now = self.clock.now()
	self:_readMonster(payload.monsterId)
	local stamp = self.catalog.StampOrder[self.random(1, #self.catalog.StampOrder)]
	local country = nil
	if not release and profile.settings.shareCountry and self.options.countryFor then local ok, result = pcall(self.options.countryFor, id); if ok and type(result) == "string" and #result <= 3 then country = result end end
	local updated = self.storage:updateMonster(payload.monsterId, function(m)
		local v = m and m.voyage
		if not m or m.state ~= "HELD" or m.version ~= payload.version or not v or v.id ~= payload.voyageId or v.holderId ~= id or v.claimToken ~= ref.token or v.holdUntil <= now or v.deadline <= now or v.visited[id] or m.ownerId == id then return nil end
		if release and v.tutorial then return nil end
		local oldToken = v.claimToken
		v.holderId = nil; v.claimToken = nil; v.holdUntil = nil
		m.version += 1
		m.operations["release:" .. oldToken] = {kind = "inbox", target = id, token = oldToken}
		if release then m.state = "QUEUED"; return m end
		m.slots[souvenir.slot] = souvenir.id; m.earned[souvenir.id] = true
		if v.tutorial then
			m.state = "RETURNING"
			table.insert(v.events, {kind = "NPC", at = now, label = "NPC tutorial visitor forwarded", souvenirId = souvenir.id, stampId = stamp})
			m.operations["tutorial:" .. v.id] = {kind = "tutorial", target = id, at = now, souvenirId = souvenir.id, stampId = stamp}
		else
			v.visited[id] = true; v.humanHops += 1; m.lifetimeHops += 1
			local index = #v.events + 1
			table.insert(v.events, {kind = "HUMAN", at = now, label = "Anonymous courier " .. v.humanHops, souvenirId = souvenir.id, stampId = stamp, country = country, humanHop = true, rewardEligible = false})
			m.operations["carrier:" .. v.id .. ":" .. v.humanHops] = {kind = "carrier", target = id, at = now, souvenirId = souvenir.id, stampId = stamp, eventIndex = index}
			m.operations["owner:" .. v.id .. ":" .. v.humanHops] = {kind = "ownerAllocation", target = m.ownerId, at = now, eventIndex = index}
			m.state = if v.humanHops >= v.hopTarget then "RETURNING" else "QUEUED"
		end
		return m
	end)
	expect(updated and updated.version == payload.version + 1, "This visitor changed, its hold expired, or it needs the free tutorial souvenir. Refresh and retry.")
	self:_process(payload.monsterId)
	return {kind = "forward", monsterId = payload.monsterId, free = true, released = release}
end

function VoyageService:_compactReceipts(p)
	if count(p.receipts) < 192 then return end
	p.receiptEpoch += 1
	for id, receipt in pairs(p.receipts) do if receipt.acknowledged then p.receipts[id] = nil end end
	expect(count(p.receipts) < 256, "Reward recovery is busy. Please retry shortly.")
end

function VoyageService:_allocateCap(p, family, day, limit)
	local buckets = p.caps[family]
	if day <= (p.capFloor[family] or -1) then return false end
	local key = tostring(day)
	local used = buckets[key] or 0
	local eligible = used < limit
	if eligible then buckets[key] = used + 1 end
	-- Close historical days conservatively; delayed allocation cannot bypass a cap.
	if count(buckets) > 64 then
		local oldest = math.huge
		for recorded in pairs(buckets) do oldest = math.min(oldest, tonumber(recorded)) end
		buckets[tostring(oldest)] = nil; p.capFloor[family] = math.max(p.capFloor[family] or -1, oldest)
	end
	return eligible
end

function VoyageService:_deliver(monsterId, operationId)
	local monster = self.storage:getMonster(monsterId)
	local op = monster and monster.operations[operationId]
	if not op then return end
	if op.kind == "inbox" then
		self:_removeInbox(op.target, monsterId, op.token)
		self.storage:updateMonster(monsterId, function(m) if m then m.operations[operationId] = nil end; return m end)
		return
	end
	local p = self.storage:getProfile(op.target)
	if not p then return end
	-- Persist an epoch before delivery. Compaction fences already-running stale workers.
	if op.epoch ~= p.receiptEpoch and not p.receipts[operationId] then
		monster = self.storage:updateMonster(monsterId, function(m)
			local existing = m and m.operations[operationId]
			if existing and not existing.delivered then existing.epoch = p.receiptEpoch end
			return m
		end)
		op = monster and monster.operations[operationId]
		if not op then return end
	end
	if not op.delivered then
		local result = self.storage:updateProfile(op.target, function(profile)
			if not profile then return nil end
			if profile.receipts[operationId] then return profile end
			if profile.receiptEpoch ~= op.epoch then return nil end
			self:_compactReceipts(profile)
			-- Compaction may have advanced the epoch; retry through canonical fencing.
			if profile.receiptEpoch ~= op.epoch then return profile end
			local receipt = {amount = 0, eligible = false, acknowledged = false}
			local day = self.config.day(op.at)
			if op.kind == "carrier" then
				receipt.eligible = self:_allocateCap(profile, "carrier", day, self.config.CarrierDailyCap)
				receipt.amount = if receipt.eligible then self.config.CarrierReward else 0
				profile.xp += self.config.ForwardXP; profile.stats.forwards += 1
				if profile.requests.day ~= day and day >= profile.requests.day then profile.requests = {day = day, counters = {}, claimed = {}} end
				if profile.requests.day == day then profile.requests.counters.forwards = (profile.requests.counters.forwards or 0) + 1 end
			elseif op.kind == "ownerAllocation" then
				receipt.eligible = self:_allocateCap(profile, "owner", day, self.config.OwnerDailyHopCap)
			elseif op.kind == "homecoming" then
				receipt.amount = op.amount; profile.xp += self.config.HomecomingXP
				if profile.outgoing[monsterId] == op.launchOperation then profile.outgoing[monsterId] = nil end
				profile.launchReservations[op.launchOperation] = nil
				profile.launchFloor[monsterId] = math.max(profile.launchFloor[monsterId] or 0, op.launchVersion or 0)
				if profile.practiceActive == op.launchOperation then profile.practiceActive = nil end
				if op.practice then profile.tutorial.practice = true end
			elseif op.kind == "tutorial" then profile.tutorial.visitor = true end
			if op.souvenirId then profile.album[op.souvenirId] = {at = op.at, context = if op.kind == "tutorial" then "NPC tutorial visitor" else "A visitor you helped"} end
			if op.stampId then profile.stamps[op.stampId] = {at = op.at, context = "Fictional postal destination"} end
			if op.discoveries then for item in pairs(op.discoveries) do profile.album[item] = profile.album[item] or {at = op.at, context = if op.practice then "Practice NPC postcard" else "Homecoming souvenir"} end end
			if op.stamps then for item in pairs(op.stamps) do profile.stamps[item] = profile.stamps[item] or {at = op.at, context = "Fictional postal destination"} end end
			profile.currency += receipt.amount
			profile.receipts[operationId] = receipt
			return profile
		end)
		local receipt = result and result.receipts[operationId]
		if not receipt then return end
		monster = self.storage:updateMonster(monsterId, function(m)
			local existing = m and m.operations[operationId]
			if not existing or existing.delivered then return m end
			existing.delivered = true; existing.result = copy(receipt)
			if existing.kind == "ownerAllocation" and existing.result.eligible then
				m.voyage.rewardHops += 1
				m.voyage.events[existing.eventIndex].rewardEligible = true
			end
			return m
		end)
	end
	-- Acknowledgment follows canonical delivery, so only safely completed receipts compact.
	self.storage:updateProfile(op.target, function(profile)
		if profile and profile.receipts[operationId] then profile.receipts[operationId].acknowledged = true end
		return profile
	end)
	self.storage:updateMonster(monsterId, function(m) if m and m.operations[operationId] and m.operations[operationId].delivered then m.operations[operationId] = nil end; return m end)
end

function VoyageService:_drain(monsterId)
	local monster = self.storage:getMonster(monsterId)
	if not monster then return end
	for operationId in pairs(monster.operations or {}) do
		if not self.storage:hasBudget() then return end
		self:_deliver(monsterId, operationId)
	end
end

function VoyageService:_recall(id, payload)
	local now = self.clock.now()
	local changed = self.storage:updateMonster(payload.monsterId, function(m)
		if not m or m.ownerId ~= id or not m.voyage or m.voyage.id ~= payload.voyageId or m.voyage.tutorial or m.state == "HOME" or m.state == "LAUNCH_PENDING" then return nil end
		if now - m.voyage.startedAt < self.config.EarlyReturnSeconds then return nil end
		if m.state ~= "RETURNING" then
			if m.voyage.holderId then m.operations["release:" .. m.voyage.claimToken] = {kind = "inbox", target = m.voyage.holderId, token = m.voyage.claimToken} end
			m.voyage.holderId = nil; m.voyage.claimToken = nil; m.voyage.holdUntil = nil; m.state = "RETURNING"; m.version += 1
		end
		return m
	end)
	expect(changed and changed.ownerId == id and changed.state == "RETURNING", "This voyage changed, or early return needs ten minutes after departure. Refresh tracking and retry.")
	self:_process(payload.monsterId)
	return {kind = "return", monsterId = payload.monsterId}
end

function VoyageService:_npc(monster)
	local now = self.clock.now()
	local interval = if monster.voyage.practice then self.config.PracticeNpcInterval else self.config.NpcInterval
	if monster.voyage.npcCount >= self.config.MaxNpcPostcards or now - monster.voyage.lastNpcAt < interval then return end
	local eventTime = monster.voyage.lastNpcAt + interval
	local index = monster.voyage.npcCount + 1
	local variation = if monster.voyage.practice then 0 else (monster.voyageNumber - 1) % 4
	local souvenirId = self.catalog.SouvenirOrder[({1, 5, 9})[index] + variation]
	local souvenir = self.catalog.Souvenirs[souvenirId]
	local stamp = self.catalog.StampOrder[(monster.seed + index + (monster.voyageNumber - 1) * 3) % #self.catalog.StampOrder + 1]
	self.storage:updateMonster(monster.id, function(m)
		if not m or m.state ~= "QUEUED" or m.version ~= monster.version then return nil end
		m.voyage.npcCount += 1; m.voyage.lastNpcAt = eventTime; m.version += 1
		m.slots[souvenir.slot] = souvenirId; m.earned[souvenirId] = true
		table.insert(m.voyage.events, {kind = "NPC", at = eventTime, label = self.catalog.NpcNames[index] .. " — fictional postal stop", souvenirId = souvenirId, stampId = stamp, humanHop = false, rewardEligible = false})
		return m
	end)
end

function VoyageService:_return(monster)
	if count(monster.operations) > 0 then return end
	local now = self.clock.now()
	self.storage:updateMonster(monster.id, function(m)
		if not m or m.state ~= "RETURNING" or count(m.operations) > 0 then return nil end
		local v = m.voyage
		if v.tutorial then m.state = "HOME"; m.version += 1; m.voyage = nil; return m end
		local families, hasHat, discoveries, stamps = {}, false, {}, {}
		for _, event in ipairs(v.events) do
			if event.souvenirId then
				local item = self.catalog.Souvenirs[event.souvenirId]; families[item.family] = true; hasHat = hasHat or item.family == "hat"; discoveries[item.id] = true
			end
			if event.stampId then stamps[event.stampId] = true end
		end
		local achieved = v.npcCount >= self.config.MaxNpcPostcards or (v.objective == "hat" and hasHat) or (v.objective == "families" and count(families) >= 2)
		local objectiveReward = if achieved and not v.practice then self.config.Objectives[v.objective].reward else 0
		local payout = v.deposit + v.rewardHops * self.config.OwnerHopReward + objectiveReward
		table.insert(v.events, {kind = "RETURN", at = now, label = "Home sweet home"})
		local book = {id = v.id, number = m.voyageNumber, plan = v.plan, practice = v.practice, events = copy(v.events), slotsBefore = v.slotsBefore, slotsAfter = copy(m.slots),
			humanHops = v.humanHops, rewardHops = v.rewardHops, startedAt = v.startedAt, returnedAt = now, deposit = v.deposit, payout = payout, objectiveReward = objectiveReward, claimed = false}
		table.insert(m.books, book)
		while #m.books > self.config.BookRetention do table.remove(m.books, 1) end
		m.voyagesCompleted += 1
		if v.practice then m.practiceVoyagesCompleted = (m.practiceVoyagesCompleted or 0) + 1
		else m.normalVoyagesCompleted = (m.normalVoyagesCompleted or 0) + 1 end
		m.state = "HOME"; m.version += 1; m.voyage = nil
		m.operations["return:" .. v.id] = {kind = "homecoming", target = m.ownerId, at = now, amount = payout, practice = v.practice, launchOperation = m.launchOperation, launchVersion = m.launchVersion, discoveries = discoveries, stamps = stamps}
		return m
	end)
end

function VoyageService:_process(monsterId)
	local monster = self:_readMonster(monsterId)
	if not monster then return end
	if monster.state == "HOME" and count(monster.operations) == 0 then return end
	if monster.state == "LAUNCH_PENDING" then self:_prepareLaunch(monster); monster = self.storage:getMonster(monsterId) end
	self:_drain(monsterId)
	monster = self.storage:getMonster(monsterId)
	if not monster or not monster.voyage then return end
	if monster.state == "HELD" then self:_repairHeld(monster); monster = self.storage:getMonster(monsterId) end
	local now = self.clock.now()
	if monster.state == "QUEUED" and monster.voyage.practice and not monster.voyage.tutorial then
		for _ = 1, self.config.MaxNpcPostcards do self:_npc(monster); monster = self.storage:getMonster(monsterId) end
	end
	if not monster.voyage.tutorial and (monster.voyage.deadline <= now or (monster.state == "HELD" and monster.voyage.holdUntil <= now)) then
		self.storage:updateMonster(monsterId, function(m)
			if not m or m.version ~= monster.version or not m.voyage then return nil end
			local v = m.voyage
			if v.holderId then m.operations["release:" .. v.claimToken] = {kind = "inbox", target = v.holderId, token = v.claimToken} end
			v.holderId = nil; v.claimToken = nil; v.holdUntil = nil
			m.state = if v.deadline <= now then "RETURNING" else "QUEUED"; m.version += 1
			return m
		end)
		self:_drain(monsterId)
		monster = self.storage:getMonster(monsterId)
	end
	if monster.state == "RETURNING" then self:_return(monster); self:_drain(monsterId)
	elseif monster.state == "QUEUED" then
		self.storage:enqueue(monsterId, now)
		if not self:_match(monster) then self:_npc(monster) end
	end
end

function VoyageService:_claim(id, payload)
	local changed = self.storage:updateMonster(payload.monsterId, function(m)
		if not m or m.ownerId ~= id then return nil end
		for _, book in ipairs(m.books) do if book.id == payload.bookId then book.claimed = true; return m end end
		return nil
	end)
	expect(changed and changed.ownerId == id, "That homecoming is not available.")
	local practice = false
	for _, book in ipairs(changed.books) do if book.id == payload.bookId then practice = book.practice end end
	if practice then self.storage:updateProfile(id, function(p) if p then p.tutorial.claimed = true; p.cosmetics["decor:welcome"] = true end; return p end) end
	self:_drain(payload.monsterId)
	return {kind = "homecoming", monsterId = payload.monsterId, bookId = payload.bookId}
end

function VoyageService:_skip(id)
	self.storage:updateProfile(id, function(p)
		if p then p.tutorial.skipped = true; p.tutorial.claimed = true; p.cosmetics["decor:welcome"] = true end
		return p
	end)
	return {kind = "notice", message = "Guidance skipped. Your free first hatch, 40 starting Postage, and welcome pennant are yours."}
end

function VoyageService:publicMonster(monster, visitor)
	local m = copy(monster)
	m.ownerId = nil; m.operations = nil; m.launchOperation = nil; m.launchVersion = nil; m.launchCancelled = nil; m.tutorialFor = nil
	if m.voyage then m.voyage.visited = nil; m.voyage.holderId = nil; m.voyage.claimToken = nil end
	if visitor then m.books = {} end
	return m
end

function VoyageService:snapshot(userId)
	local id = tostring(userId)
	local profile = self.storage:getProfile(id)
	expect(profile, "Your profile is still loading. Please retry.")
	local monsters, visitors = {}, {}
	for _, monsterId in ipairs(profile.owned) do local m = self.storage:getMonster(monsterId); if m and m.ownerId == id then table.insert(monsters, self:publicMonster(m)) end end
	for monsterId, ref in pairs(profile.inbox) do
		local m = self.storage:getMonster(monsterId)
		if m and m.state == "HELD" and m.voyage and m.voyage.holderId == id and m.voyage.claimToken == ref.token and m.voyage.holdUntil > self.clock.now() then table.insert(visitors, self:publicMonster(m, true)) end
	end
	local public = copy(profile)
	public.pendingEggs = count(profile.pendingHatches)
	public.id = nil; public.receipts = nil; public.receiptEpoch = nil; public.launchReservations = nil; public.pendingHatches = nil; public.inbox = nil; public.capFloor = nil; public.launchFloor = nil; public.practiceActive = nil; public.activitySession = nil; public.activityReceipt = nil
	public.level = self:level(profile)
	local day = tostring(self.config.day(self.clock.now()))
	public.daily = {carrier = profile.caps.carrier[day] or 0, owner = profile.caps.owner[day] or 0, carrierLimit = self.config.CarrierDailyCap, ownerLimit = self.config.OwnerDailyHopCap}
	public.caps = nil
	self.profiles[id] = copy(profile)
	return {profile = public, monsters = monsters, visitors = visitors, serverTime = self.clock.now(), simulation = self.storage.simulation}
end

function VoyageService:handle(userId, action, payload)
	local id = tostring(userId)
	payload = payload or {}
	local ok, result = pcall(function()
		local effect
		if action == "Snapshot" then return {ok = true, data = self:snapshot(id)}
		elseif action == "Hatch" then effect = self:_hatch(id, payload)
		elseif action == "Launch" then effect = self:_launch(id, payload)
		elseif action == "Forward" then effect = self:_forward(id, payload, false)
		elseif action == "ReleaseVisitor" then effect = self:_forward(id, payload, true)
		elseif action == "Recall" then effect = self:_recall(id, payload)
		elseif action == "ClaimHomecoming" then effect = self:_claim(id, payload)
		elseif action == "SkipTutorial" then effect = self:_skip(id)
		else return {ok = false, error = "Unknown action."} end
		return {ok = true, effect = effect, data = self:snapshot(id)}
	end)
	if not ok then return {ok = false, error = tostring(result)} end
	return result
end

function VoyageService:tick()
	local now = self.clock.now()
	local function workerBudget() return self.storage:hasBudget(self.config.BackgroundReadReserve, self.config.BackgroundWriteReserve) end
	if not workerBudget() then return end
	if now - self.lastPresence >= 30 then
		for id in pairs(self.active) do
			if not workerBudget() then return end
			local profile = self.storage:getProfile(id)
			if profile then
				if next(profile.pendingHatches) then self:_recoverHatches(id) end
				if profile.tutorial.hatched and not profile.tutorial.visitor and not profile.tutorial.skipped then self:_ensureTutorialVisitor(id) end
				if next(profile.inbox) then self:_repairInbox(id) end
				self:_presence(id, profile)
			end
		end
		self.lastPresence = now
	end
	if not workerBudget() then return end
	local processed = {}
	for _, monsterId in ipairs(self.storage:listHints(self.config.RecoveryBatchSize)) do
		if not workerBudget() then return end
		processed[monsterId] = true
		if self.storage:lease("m:" .. monsterId, self.workerId, now, self.config.LeaseSeconds) then
			self:_process(monsterId)
			local m = self.storage:getMonster(monsterId)
			if not m or m.state == "HOME" or m.state == "HELD" then self.storage:removeHint(monsterId) end
		end
	end
	if now - self.lastRecovery >= self.config.RecoveryInterval then
		local partition = self.recoveryPartition
		local checkpointName = "enumerator:" .. tostring(partition)
		self.recoveryPartition = partition % (self.storage.recoveryPartitions or 1) + 1
		if not self.storage:lease(checkpointName, self.workerId, now, self.config.LeaseSeconds) then return end
		local checkpoint = self.storage:getCheckpoint(checkpointName) or {}
		local ids, cursor = self.storage:listMonsterIds(checkpoint.cursor, self.config.RecoveryBatchSize, partition)
		for _, monsterId in ipairs(ids) do
			if not workerBudget() then return end
			if not processed[monsterId] then self:_process(monsterId) end
		end
		-- Advance only after the complete page succeeds. A crash replays this page safely.
		self.storage:setCheckpoint(checkpointName, {cursor = cursor, at = now})
		self.lastRecovery = now
	end
end

return VoyageService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!strict
-- Temporary island geometry. Persistent ownership, purchases and placements are
-- owned by Gameplay/VoyageService; no world instance is a currency authority.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local Shared = ReplicatedStorage:WaitForChild("MailAMonster"):WaitForChild("Shared")
local Catalog = require(Shared:WaitForChild("Catalog"))
local MonsterFactory = require(Shared:WaitForChild("MonsterFactory"))

local World = {}
local activeWorld: any = nil
local C = {
	cream = Color3.fromRGB(255, 244, 218), teal = Color3.fromRGB(65, 164, 160),
	coral = Color3.fromRGB(244, 139, 128), lavender = Color3.fromRGB(187, 165, 222),
	sky = Color3.fromRGB(149, 210, 236), ink = Color3.fromRGB(48, 69, 82),
	grass = Color3.fromRGB(174, 213, 170), leaf = Color3.fromRGB(108, 173, 126),
	lemon = Color3.fromRGB(251, 221, 127), white = Color3.fromRGB(255, 251, 237),
}

local function makeModel(parent: Instance?, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "Origin"
	root.Size = Vector3.one * 0.1
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.identity
	root.Parent = model
	model.PrimaryPart = root
	model.Parent = parent
	return model
end

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?, collide: boolean?): Part
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = cf
	object.Color = color
	object.Material = Enum.Material.SmoothPlastic
	object.Shape = shape or Enum.PartType.Block
	object.Anchored = true
	object.CanCollide = collide ~= false
	object.CanTouch = false
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function ball(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3, collide: boolean?): Part
	return part(parent, name, size, CFrame.new(position), color, Enum.PartType.Ball, collide)
end

local function disc(parent: Instance, name: string, position: Vector3, radius: number, height: number, color: Color3, collide: boolean?): Part
	return part(parent, name, Vector3.new(height, radius * 2, radius * 2), CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.PartType.Cylinder, collide)
end

local function rod(parent: Instance, name: string, a: Vector3, b: Vector3, width: number, color: Color3, collide: boolean?): Part
	return part(parent, name, Vector3.new(width, width, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), color, nil, collide)
end

local function label(parent: BasePart, text: string, width: number?, height: number?, offset: number?, color: Color3?): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.fromOffset(width or 190, height or 60)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offset or 2.8, 0)
	gui.MaxDistance = 115
	gui.AlwaysOnTop = false
	local textLabel = Instance.new("TextLabel")
	textLabel.Name = "Text"
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.BackgroundColor3 = C.white
	textLabel.BackgroundTransparency = 0.08
	textLabel.Text = text
	textLabel.TextColor3 = color or C.ink
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 16
	textLabel.TextWrapped = true
	textLabel.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = textLabel
	local stroke = Instance.new("UIStroke")
	stroke.Color = C.ink
	stroke.Transparency = 0.8
	stroke.Thickness = 1
	stroke.Parent = textLabel
	gui.Parent = parent
	return gui
end

local function prompt(parent: BasePart, action: string, title: string, kind: string?, target: string?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = "Interact"
	p.ActionText = title
	p.ObjectText = "MAIL A MONSTER"
	p.HoldDuration = 0
	p.MaxActivationDistance = 12
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p:SetAttribute("MAMAction", action)
	p:SetAttribute("MAMKind", kind or "")
	if target then p:SetAttribute("MAMTarget", target) end
	p.Parent = parent
	return p
end

local function envelope(parent: Instance, cf: CFrame, width: number, color: Color3): Part
	local base = part(parent, "Envelope", Vector3.new(width, width * 0.66, 0.12), cf, color, nil, false)
	local a = cf:PointToWorldSpace(Vector3.new(-width * 0.48, width * 0.29, -0.07))
	local b = cf:PointToWorldSpace(Vector3.new(width * 0.48, width * 0.29, -0.07))
	local middle = cf:PointToWorldSpace(Vector3.new(0, -width * 0.09, -0.07))
	rod(parent, "Fold", a, middle, 0.06, C.coral, false)
	rod(parent, "Fold", b, middle, 0.06, C.coral, false)
	return base
end

local function flower(parent: Instance, position: Vector3, color: Color3, scale: number?)
	local s = scale or 1
	rod(parent, "Stem", position, position + Vector3.new(0, 1.4 * s, 0), 0.13 * s, C.leaf, false)
	for i = 0, 4 do
		local a = i * math.pi * 2 / 5
		ball(parent, "Petal", Vector3.new(0.6, 0.23, 0.6) * s, position + Vector3.new(math.sin(a) * 0.36, 1.45, math.cos(a) * 0.36) * s, color, false)
	end
	ball(parent, "Pollen", Vector3.new(0.44, 0.28, 0.44) * s, position + Vector3.new(0, 1.52 * s, 0), C.lemon, false)
end

local function island(parent: Instance, radius: number, color: Color3)
	disc(parent, "WalkableIsland", Vector3.new(0, -1, 0), radius, 2, color)
	disc(parent, "CreamRim", Vector3.new(0, -2.25, 0), radius + 0.2, 0.7, C.cream)
	ball(parent, "FloatingStone", Vector3.new(radius * 1.9, 11, radius * 1.9), Vector3.new(0, -7, 0), C.lavender, false)
	ball(parent, "IslandCloud", Vector3.new(radius * 1.65, 7, radius * 1.65), Vector3.new(0, -11, 0), C.white, false)
end

local function buildCannon(style: string): Model
	local model = makeModel(nil, "Cannon")
	local definition = Catalog.Cannons[style] or Catalog.Cannons.classic
	local color = Color3.fromRGB(table.unpack(definition.rgb))
	disc(model, "Plinth", Vector3.new(0, 0.3, 0), 4, 0.6, C.cream)
	local base = part(model, "Base", Vector3.new(5.3, 1.4, 3.8), CFrame.new(0, 1.35, 0.8), C.ink)
	for _, side in ipairs({ -1, 1 }) do
		part(model, "Wheel", Vector3.new(0.5, 2.5, 2.5), CFrame.new(side * 2.75, 1.4, 0.8), C.coral, Enum.PartType.Cylinder)
	end
	-- Cylinder's native axis is X. Rotate its geometry while Muzzle keeps a
	-- conventional LookVector aimed out of the barrel for client effects.
	local aim = CFrame.new(0, 3.5, -0.8) * CFrame.Angles(math.rad(23), 0, 0)
	part(model, "Barrel", Vector3.new(6.5, 3.4, 3.4), aim * CFrame.Angles(0, math.pi / 2, 0), color, Enum.PartType.Cylinder)
	part(model, "BarrelRim", Vector3.new(0.4, 3.7, 3.7), aim * CFrame.new(0, 0, -3.2) * CFrame.Angles(0, math.pi / 2, 0), C.lemon, Enum.PartType.Cylinder)
	part(model, "Opening", Vector3.new(0.08, 2.9, 2.9), aim * CFrame.new(0, 0, -3.43) * CFrame.Angles(0, math.pi / 2, 0), C.ink, Enum.PartType.Cylinder, false)
	local muzzle = part(model, "Muzzle", Vector3.one * 0.1, aim * CFrame.new(0, 0, -3.6), color, nil, false)
	muzzle.Transparency = 1
	envelope(model, CFrame.new(0, 3.6, -1.9), 1.55, C.cream)
	label(base, "POSTAL CANNON\nSend a smile", 195, 58, 5)
	prompt(base, "Launch", "Plan a voyage")
	model:SetAttribute("Style", style)
	return model
end

local function buildMailbox(style: string): Model
	local model = makeModel(nil, "Mailbox")
	local definition = Catalog.Mailboxes[style] or Catalog.Mailboxes.classic
	local color = Color3.fromRGB(table.unpack(definition.rgb))
	disc(model, "MailboxPlinth", Vector3.new(0, 0.15, 0), 3.4, 0.3, C.cream)
	part(model, "Post", Vector3.new(0.65, 2.9, 0.65), CFrame.new(0, 1.5, 0), C.ink)
	local body = part(model, "Body", Vector3.new(4, 2.3, 2.6), CFrame.new(0, 3.15, 0), color)
	if style == "cottage" then
		for _, sign in ipairs({ -1, 1 }) do
			part(model, "CottageRoof", Vector3.new(2.7, 0.28, 3.1), CFrame.new(sign * 0.85, 4.73, 0) * CFrame.Angles(0, 0, sign * -0.5), C.cream)
		end
		part(model, "Chimney", Vector3.new(0.55, 1.5, 0.65), CFrame.new(1.3, 5.0, 0.4), C.coral)
	elseif style == "cloud" then
		for i = -1, 1 do
			ball(model, "CloudRoof", Vector3.new(2.5, 1.8, 3), Vector3.new(i * 1.1, 4.07 + (i == 0 and 0.4 or 0), 0), C.white)
		end
	else
		ball(model, "RoundRoof", Vector3.new(4, 1.65, 2.6), Vector3.new(0, 4.05, 0), color)
	end
	part(model, "MailSlot", Vector3.new(2.7, 0.27, 0.1), CFrame.new(0, 3.62, -1.34), C.ink, nil, false)
	envelope(model, CFrame.new(0, 2.8, -1.4), 1.2, C.cream)
	part(model, "FlagPole", Vector3.new(0.12, 2.4, 0.12), CFrame.new(2.35, 4, 0), C.ink, nil, false)
	part(model, "Flag", Vector3.new(0.92, 0.67, 0.15), CFrame.new(2.74, 4.83, 0), C.lemon, nil, false)
	label(body, "VISITOR MAILBOX\nFree souvenirs + forwarding", 220, 60, 3.9)
	prompt(body, "Mailbox", "Meet visitors")
	model:SetAttribute("Style", style)
	return model
end

local function buildHatchery(parent: Instance)
	local model = makeModel(parent, "Hatchery")
	disc(model, "NestBase", Vector3.new(0, 0.35, 0), 4, 0.7, C.lavender)
	disc(model, "Nest", Vector3.new(0, 0.8, 0), 3.1, 0.3, C.lemon)
	local egg = ball(model, "Egg", Vector3.new(3.3, 4.2, 3.3), Vector3.new(0, 2.83, 0), C.cream)
	for i = 0, 3 do
		local a = i * math.pi / 2
		ball(model, "EggSpot", Vector3.new(0.65, 0.75, 0.2), Vector3.new(math.sin(a) * 1.18, 2.5 + (i % 2) * 0.95, -1.53 + math.abs(math.sin(a)) * 0.6), i % 2 == 0 and C.teal or C.coral, false)
	end
	label(egg, "HATCHERY\nA little friend awaits", 195, 60, 3.5)
	prompt(egg, "Hatch", "Hatch a monster")
	model:PivotTo(CFrame.new(-12, 0, 0))
end

local function buildDecoration(id: string): Model
	local model = makeModel(nil, "Decoration_" .. id)
	local definition = Catalog.Decorations[id] or Catalog.Decorations.welcome
	local color = Color3.fromRGB(table.unpack(definition.rgb))
	if id == "welcome" then
		part(model, "Pole", Vector3.new(0.22, 4, 0.22), CFrame.new(-1, 2, 0), C.ink, nil, false)
		local flag = part(model, "Pennant", Vector3.new(2.1, 1.5, 0.12), CFrame.new(0, 3.1, 0), color, nil, false)
		label(flag, "WELCOME!", 95, 30, 0)
	elseif id == "planter" then
		disc(model, "PlantPot", Vector3.new(0, 0.6, 0), 1.3, 1.2, color, false)
		for i = -1, 1 do flower(model, Vector3.new(i * 0.6, 1.2, (i % 2) * 0.4), C.white, 0.85) end
	elseif id == "bench" then
		part(model, "Seat", Vector3.new(4.4, 0.38, 1.5), CFrame.new(0, 1.1, 0), color, nil, false)
		part(model, "Back", Vector3.new(4.4, 1.2, 0.3), CFrame.new(0, 1.8, 0.6), color, nil, false)
		for _, sign in ipairs({ -1, 1 }) do part(model, "Leg", Vector3.new(0.4, 1.1, 1.3), CFrame.new(sign * 1.5, 0.55, 0), C.cream, nil, false) end
	elseif id == "lantern" then
		part(model, "Post", Vector3.new(0.24, 3.7, 0.24), CFrame.new(0, 1.85, 0), C.ink, nil, false)
		local glow = part(model, "Lantern", Vector3.new(1.4, 1.45, 1.2), CFrame.new(0, 3.9, 0), color, nil, false)
		glow.Material = Enum.Material.Neon
		part(model, "Top", Vector3.new(1.65, 0.2, 1.45), CFrame.new(0, 4.67, 0), C.ink, nil, false)
		envelope(model, CFrame.new(0, 3.9, -0.65), 0.9, C.cream)
	elseif id == "mushrooms" then
		for i = -1, 1 do
			local y = i == 0 and 1.4 or 0.85
			disc(model, "Stem", Vector3.new(i * 1.25, y / 2, math.abs(i) * 0.4), 0.3, y, C.cream, false)
			ball(model, "Cap", Vector3.new(1.6, 0.65, 1.6), Vector3.new(i * 1.25, y, math.abs(i) * 0.4), color, false)
			ball(model, "Spot", Vector3.new(0.45, 0.13, 0.45), Vector3.new(i * 1.25, y + 0.34, math.abs(i) * 0.4), C.white, false)
		end
	elseif id == "birdbath" then
		disc(model, "Stem", Vector3.new(0, 1, 0), 0.45, 2, C.cream, false)
		disc(model, "Basin", Vector3.new(0, 2.1, 0), 1.6, 0.4, C.cream, false)
		disc(model, "Water", Vector3.new(0, 2.32, 0), 1.35, 0.05, color, false)
		ball(model, "Bird", Vector3.new(0.6, 0.6, 0.8), Vector3.new(1.12, 2.72, 0), C.lemon, false)
	elseif id == "windchime" then
		part(model, "Post", Vector3.new(0.22, 4.8, 0.22), CFrame.new(-1.6, 2.4, 0), C.ink, nil, false)
		part(model, "Arm", Vector3.new(3.4, 0.25, 0.3), CFrame.new(0, 4.7, 0), color, nil, false)
		for i = -1, 1 do
			rod(model, "String", Vector3.new(i, 4.7, 0), Vector3.new(i, 3.1 - math.abs(i) * 0.45, 0), 0.04, C.ink, false)
			envelope(model, CFrame.new(i, 2.85 - math.abs(i) * 0.45, 0), 0.8, i == 0 and C.coral or C.cream)
		end
	elseif id == "arch" then
		for _, sign in ipairs({ -1, 1 }) do
			part(model, "Pillar", Vector3.new(0.55, 5.5, 0.65), CFrame.new(sign * 2, 2.75, 0), color, nil, false)
			ball(model, "RoundTop", Vector3.new(1.0, 1, 1), Vector3.new(sign * 2, 5.5, 0), C.lemon, false)
		end
		part(model, "Lintel", Vector3.new(4.6, 0.55, 0.65), CFrame.new(0, 5.5, 0), color, nil, false)
		envelope(model, CFrame.new(0, 5.5, -0.4), 1.5, C.cream)
	elseif id == "fountain" then
		disc(model, "Saucer", Vector3.new(0, 0.22, 0), 2, 0.4, C.cream, false)
		disc(model, "Cup", Vector3.new(0, 1.1, 0), 1.35, 1.7, C.cream, false)
		disc(model, "Water", Vector3.new(0, 1.98, 0), 1.15, 0.04, color, false)
		part(model, "Jet", Vector3.new(0.2, 1.4, 0.2), CFrame.new(0, 2.5, 0), color, nil, false)
		ball(model, "Drop", Vector3.new(0.5, 0.8, 0.5), Vector3.new(0, 3.2, 0), color, false)
		for _, y in ipairs({ 0.7, 1.5 }) do part(model, "CupHandle", Vector3.new(0.85, 0.22, 0.25), CFrame.new(1.6, y, 0), C.cream, nil, false) end
		part(model, "HandleEnd", Vector3.new(0.22, 1, 0.25), CFrame.new(2, 1.1, 0), C.cream, nil, false)
	elseif id == "telescope" then
		for i = 0, 2 do
			local a = i * math.pi * 2 / 3
			rod(model, "Tripod", Vector3.new(math.sin(a) * 1.35, 0, math.cos(a) * 1.35), Vector3.new(0, 2.45, 0), 0.16, C.ink, false)
		end
		local frame = CFrame.new(0, 2.8, 0) * CFrame.Angles(-0.35, 0, 0)
		part(model, "Tube", Vector3.new(3, 0.8, 0.8), frame * CFrame.Angles(0, math.pi / 2, 0), color, Enum.PartType.Cylinder, false)
		part(model, "Lens", Vector3.new(0.1, 0.85, 0.85), frame * CFrame.new(0, 0, -1.55) * CFrame.Angles(0, math.pi / 2, 0), C.sky, Enum.PartType.Cylinder, false)
	elseif id == "balloons" then
		for i = -1, 1 do
			local top = Vector3.new(i * 0.95, 4.4 + (i == 0 and 0.9 or 0), math.abs(i) * 0.4)
			rod(model, "Ribbon", Vector3.new(0, 0.1, 0), top, 0.035, C.ink, false)
			ball(model, "Balloon", Vector3.new(1.65, 2, 1.65), top, i == 0 and C.lavender or color, false)
		end
	else
		disc(model, "StatuePlinth", Vector3.new(0, 0.3, 0), 1.8, 0.6, C.cream, false)
		local monster = MonsterFactory.create({ name = "Golden courier", body = "puff", palette = "lemon", face = "smile", slots = { hat = "postcap" } }, 0.6)
		monster:PivotTo(CFrame.new(0, 0.6, 0))
		monster.Parent = model
	end
	model:SetAttribute("DecorationId", id)
	return model
end

local flowerPositions = { Vector3.new(-22, 0, 4), Vector3.new(-21, 0, 12), Vector3.new(-15, 0, 21), Vector3.new(-7, 0, 23) }
local letterPositions = { Vector3.new(17, 0, -16), Vector3.new(23, 0, -8), Vector3.new(23, 0, 2), Vector3.new(21, 0, 12), Vector3.new(14, 0, 21), Vector3.new(5, 0, 23) }
local anchorPositions = { Vector3.new(-7, 0, -13), Vector3.new(7, 0, -13), Vector3.new(-19, 0, -4), Vector3.new(19, 0, -4), Vector3.new(-9, 0, 8), Vector3.new(9, 0, 8), Vector3.new(-5, 0, 17), Vector3.new(5, 0, 17) }

local function buildPlot(parent: Instance, index: number, frame: CFrame): any
	local model = makeModel(parent, "Plot" .. tostring(index))
	model:SetAttribute("PlotIndex", index)
	model:SetAttribute("Occupied", false)
	island(model, 29, C.grass)
	part(model, "EntryPath", Vector3.new(7, 0.14, 29), CFrame.new(0, 0.04, -13.8), C.cream)
	part(model, "CrossPath", Vector3.new(38, 0.14, 6), CFrame.new(0, 0.05, -2), C.cream)
	for _, x in ipairs({ -20, 20 }) do part(model, "ActivityPath", Vector3.new(4.7, 0.1, 28), CFrame.new(x, 0.03, 7), C.cream) end
	part(model, "BackPath", Vector3.new(29, 0.1, 4.7), CFrame.new(0, 0.03, 22), C.cream)
	buildHatchery(model)
	local mailbox = buildMailbox("classic")
	mailbox:PivotTo(CFrame.new(0, 0, -5))
	mailbox.Parent = model
	local cannon = buildCannon("classic")
	cannon:PivotTo(CFrame.new(12, 0, 0))
	cannon.Parent = model
	local namePost = part(model, "IslandSign", Vector3.new(0.3, 4, 0.3), CFrame.new(-5.5, 2, -23), C.teal)
	local nameLabel = label(namePost, "ISLAND " .. index .. "\nAwaiting a courier", 210, 60, 2.5)
	local display = makeModel(model, "Display")
	for i = 1, 3 do disc(display, "Perch" .. i, Vector3.new((i - 2) * 4.8, 0.36, 12), 2.2, 0.72, C.lavender) end
	local displayPrompt = part(display, "CollectionStand", Vector3.new(1.8, 1.3, 1.3), CFrame.new(0, 0.7, 8), C.teal)
	prompt(displayPrompt, "Collection", "Your monsters")
	label(displayPrompt, "MONSTER GARDEN", 190, 34, 2.3)
	local sorting = makeModel(model, "ParcelSorting")
	local sortingPos = Vector3.new(-19, 0, -15)
	local sortStation = part(sorting, "SortingTable", Vector3.new(7.8, 1.4, 2.6), CFrame.new(sortingPos + Vector3.new(0, 0.75, 0)), C.teal)
	for i, bin in ipairs({ { "CIRCLE", C.coral }, { "TRIANGLE", C.lemon }, { "STAR", C.lavender } }) do
		local binPart = part(sorting, "Bin" .. i, Vector3.new(2, 1.1, 2), CFrame.new(sortingPos + Vector3.new((i - 2) * 2.5, 1.9, 0)), bin[2] :: Color3)
		label(binPart, bin[1] :: string, 76, 28, 0.8)
	end
	prompt(sortStation, "ActivityStart", "Parcel sorting", "sorting")
	label(sortStation, "PARCEL SORTING\nMatch the printed shapes", 195, 58, 4.5)
	local flowers = makeModel(model, "FlowerWatering")
	for i, position in ipairs(flowerPositions) do
		local bed = disc(flowers, "FlowerBed" .. i, position + Vector3.new(0, 0.2, 0), 1.5, 0.4, C.coral, false)
		for j = -1, 1 do flower(flowers, position + Vector3.new(j * 0.55, 0.4, (j % 2) * 0.45), i % 2 == 0 and C.lavender or C.white, 0.7) end
		label(bed, "WATER " .. i, 95, 30, 2.5)
		bed:SetAttribute("MAMActivity", "watering")
		bed:SetAttribute("MAMIndex", i)
		if i == 1 then prompt(bed, "ActivityStart", "Water postal flowers", "watering") end
	end
	local letters = makeModel(model, "FloatingLetters")
	for i, position in ipairs(letterPositions) do
		disc(letters, "LetterMarker" .. i, position + Vector3.new(0, 0.12, 0), 1.25, 0.12, C.lavender, false)
		local letter = envelope(letters, CFrame.new(position + Vector3.new(0, 2.2, 0)), 1.45, C.cream)
		letter.Name = "Letter" .. i
		letter:SetAttribute("MAMActivity", "letters")
		letter:SetAttribute("MAMIndex", i)
		label(letter, "LETTER " .. i, 92, 28, 1)
		if i == 1 then prompt(letter, "ActivityStart", "Collect floating letters", "letters") end
	end
	local anchors = makeModel(model, "DecorationAnchors")
	local anchorMap = {}
	for i, position in ipairs(anchorPositions) do
		local anchor = disc(anchors, "Anchor" .. i, position + Vector3.new(0, 0.1, 0), 1.7, 0.12, C.white, false)
		anchor.Transparency = 0.38
		anchor:SetAttribute("MAMAnchor", tostring(i))
		prompt(anchor, "Decorations", "Decorate anchor " .. i, "", tostring(i))
		anchorMap[tostring(i)] = frame:PointToWorldSpace(position)
	end
	local decorations = makeModel(model, "Decorations")
	local rendered = makeModel(model, "RenderedMonsters")
	model:PivotTo(frame)
	local activity = { sorting = frame:PointToWorldSpace(sortingPos + Vector3.new(0, 2, -3)), watering = {}, letters = {} }
	for i, position in ipairs(flowerPositions) do activity.watering[i] = frame:PointToWorldSpace(position + Vector3.new(0, 2, 0)) end
	for i, position in ipairs(letterPositions) do activity.letters[i] = frame:PointToWorldSpace(position + Vector3.new(0, 2, 0)) end
	return {
		model = model, index = index, frame = frame, center = frame.Position,
		spawn = frame * CFrame.new(0, 4, -21) * CFrame.Angles(0, math.pi, 0),
		ownerId = nil, owner = nil, activity = activity, decorationAnchors = anchorMap,
		nameLabel = nameLabel, cannon = cannon, mailbox = mailbox,
		decorations = decorations, rendered = rendered, signatures = {}, signals = {},
	}
end

local function buildCenter(parent: Instance)
	local center = makeModel(parent, "CentralPostOffice")
	island(center, 34, C.cream)
	disc(center, "Plaza", Vector3.new(0, 0.04, 0), 23, 0.08, C.white)
	part(center, "OfficeBack", Vector3.new(31, 10, 1.1), CFrame.new(0, 5, 20), C.teal)
	for _, sign in ipairs({ -1, 1 }) do
		part(center, "OfficePillar", Vector3.new(1.3, 10, 1.3), CFrame.new(sign * 15, 5, 5), C.coral)
	end
	part(center, "OfficeRoof", Vector3.new(35, 1.1, 20), CFrame.new(0, 10.4, 12), C.lavender)
	part(center, "RoofStripe", Vector3.new(35, 0.4, 1.2), CFrame.new(0, 9.9, 2.2), C.cream)
	local title = part(center, "Title", Vector3.new(18, 3.8, 0.6), CFrame.new(0, 8.5, 3.2), C.cream, nil, false)
	label(title, "MAIL A MONSTER\nLittle monster. Big adventure. Send a smile.", 370, 76, 0)
	envelope(center, CFrame.new(0, 6.5, 19.36), 7, C.cream)
	local stations = {
		{ "Shop", "COSMETIC SHOP\nSpend earned Postage", Vector3.new(-12, 0, 8), C.coral },
		{ "Album", "SOUVENIR JOURNAL\nMemories + discoveries", Vector3.new(-7, 0, 17), C.lavender },
		{ "Voyages", "VOYAGE BOARD\nLittle monsters, big adventures", Vector3.new(12, 0, 8), C.teal },
		{ "Requests", "DAILY REQUESTS\nA new reason to send a smile", Vector3.new(7, 0, 17), C.sky },
	}
	for _, station in ipairs(stations) do
		local pos = station[3] :: Vector3
		local object = part(center, station[1] :: string, Vector3.new(5.2, 2.8, 2.5), CFrame.new(pos + Vector3.new(0, 1.4, 0)), station[4] :: Color3)
		envelope(center, CFrame.new(pos + Vector3.new(0, 1.8, -1.33)), 1.6, C.cream)
		label(object, station[2] :: string, 190, 60, 3.3)
		prompt(object, station[1] :: string, "Open " .. string.lower(station[1] :: string))
	end
	local guide = MonsterFactory.create({ name = "NPC Pippa Post", body = "bean", palette = "coral", face = "wink", personality = "Curious", slots = { hat = "postcap", accessory = "satchel" } }, 1.35)
	guide:PivotTo(CFrame.new(0, 0.3, -6))
	guide.Parent = center
	local guideRoot = guide.PrimaryPart :: BasePart
	label(guideRoot, "NPC PIPPA POST\nYour fictional postal guide", 230, 60, 7.5)
	prompt(guideRoot, "Tutorial", "Meet your postal guide")
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "WelcomeSpawn"
	spawn.Size = Vector3.new(7, 0.15, 7)
	spawn.CFrame = CFrame.new(0, 0.15, -17) * CFrame.Angles(0, math.pi, 0)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Enabled = true
	spawn.Duration = 0
	spawn.Transparency = 1
	spawn.Parent = center
end

local function teleportToPlot(player: Player, plot: any)
	local character = player.Character
	if not character then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then return end
	character:PivotTo(plot.spawn)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	local protection = Instance.new("ForceField")
	protection.Visible = false
	protection.Parent = character
	Debris:AddItem(protection, 3)
end

local function renderSignature(monster: any): string
	local slots = monster.slots or {}
	return table.concat({ tostring(monster.id), tostring(monster.state), tostring(monster.body), tostring(monster.palette), tostring(monster.face), tostring(slots.hat), tostring(slots.accessory), tostring(slots.patch) }, ":")
end

function World.build(): any
	if activeWorld then activeWorld:destroy() end
	local previous = workspace:FindFirstChild("MailAMonsterWorld")
	if previous then previous:Destroy() end
	local root = makeModel(workspace, "MailAMonsterWorld")
	local assets = ReplicatedStorage:WaitForChild("MailAMonster"):WaitForChild("Assets")
	local oldDecorations = assets:FindFirstChild("Decorations")
	if oldDecorations then oldDecorations:Destroy() end
	local decorationTemplates = Instance.new("Folder")
	decorationTemplates.Name = "Decorations"
	for _, id in ipairs(Catalog.DecorationOrder) do
		local template = buildDecoration(id)
		template.Name = id
		template.Parent = decorationTemplates
	end
	decorationTemplates.Parent = assets
	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = root
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(168, 164, 190)
	Lighting.OutdoorAmbient = Color3.fromRGB(187, 191, 210)
	Lighting.GlobalShadows = true
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "PostalAtmosphere"
	atmosphere.Density = 0.25
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(217, 233, 250)
	atmosphere.Decay = Color3.fromRGB(186, 190, 220)
	atmosphere.Glare = 0.12
	atmosphere.Haze = 0.7
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "PostalBloom"
	bloom.Intensity = 0.14
	bloom.Size = 16
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
	local sky = Lighting:FindFirstChildOfClass("Sky")
	local ownSky = sky == nil
	if not sky then
		sky = Instance.new("Sky")
		sky.Name = "PostalSky"
		sky.Parent = Lighting
	end
	sky.CelestialBodiesShown = true
	sky.StarCount = 0
	buildCenter(root)
	local plots = {}
	for i = 1, 8 do
		local angle = (i - 1) * math.pi / 4
		local center = Vector3.new(math.sin(angle) * 107, 0, math.cos(angle) * 107)
		local frame = CFrame.lookAt(center, Vector3.new(0, 0, 0))
		local bridgeCenter = center.Unit * 55.5
		local bridgeCf = CFrame.lookAt(bridgeCenter, Vector3.zero)
		part(root, "Bridge" .. i, Vector3.new(9, 0.5, 49), bridgeCf * CFrame.new(0, -0.15, 0), C.cream)
		for _, side in ipairs({ -1, 1 }) do
			part(root, "BridgeRail", Vector3.new(0.24, 1.2, 49), bridgeCf * CFrame.new(side * 4.55, 0.6, 0), C.teal)
			for post = -2, 2 do part(root, "BridgePost", Vector3.new(0.5, 2.3, 0.5), bridgeCf * CFrame.new(side * 4.55, 1.15, post * 10), C.coral) end
		end
		plots[i] = buildPlot(plotsFolder, i, frame)
	end
	-- A few large cloud clusters frame the archipelago; no per-frame particles.
	for i = 1, 12 do
		local a = i * math.pi / 6
		local center = Vector3.new(math.sin(a) * 153, -22 + (i % 3) * 3, math.cos(a) * 153)
		for j = -1, 1 do ball(root, "DriftingCloud", Vector3.new(24, 10, 19), center + Vector3.new(j * 13, (j % 2) * 2, 0), C.white, false) end
	end
	workspace.FallenPartsDestroyHeight = -80
	local effects: { Instance } = { atmosphere, bloom }
	if ownSky then table.insert(effects, sky) end
	local self: any = { root = root, plots = plots, byUser = {}, alive = true, lighting = effects, decorationTemplates = decorationTemplates }

	function self:getPlot(player: Player): any
		return self.byUser[player.UserId]
	end

	function self:assign(player: Player, profile: any): any
		if self.byUser[player.UserId] then return self.byUser[player.UserId] end
		local assigned = nil
		for _, plot in ipairs(self.plots) do if not plot.ownerId then assigned = plot; break end end
		if not assigned then return nil, "All eight island plots are occupied." end
		assigned.ownerId, assigned.owner = player.UserId, player
		assigned.model:SetAttribute("Occupied", true)
		assigned.cannon:SetAttribute("MAMPlotIndex", assigned.index)
		assigned.mailbox:SetAttribute("MAMPlotIndex", assigned.index)
		local textLabel = assigned.nameLabel:FindFirstChild("Text")
		if textLabel and textLabel:IsA("TextLabel") then textLabel.Text = player.DisplayName .. "'s island\nCourier " .. assigned.index end
		self.byUser[player.UserId] = assigned
		player:SetAttribute("MAMPlotIndex", assigned.index)
		assigned.signals.character = player.CharacterAdded:Connect(function(character)
			task.spawn(function()
				character:WaitForChild("HumanoidRootPart", 10)
				if self.alive and assigned.ownerId == player.UserId then teleportToPlot(player, assigned) end
			end)
		end)
		task.defer(function() if self.alive and assigned.ownerId == player.UserId then teleportToPlot(player, assigned) end end)
		self:refresh(player, profile, {}, {})
		return assigned
	end

	function self:release(player: Player)
		local plot = self.byUser[player.UserId]
		if not plot then return end
		for _, connection in pairs(plot.signals) do connection:Disconnect() end
		plot.signals = {}
		plot.ownerId, plot.owner = nil, nil
		plot.model:SetAttribute("Occupied", false)
		local textLabel = plot.nameLabel:FindFirstChild("Text")
		if textLabel and textLabel:IsA("TextLabel") then textLabel.Text = "ISLAND " .. plot.index .. "\nAwaiting a courier" end
		for _, folder in ipairs({ plot.rendered, plot.decorations }) do
			for _, child in ipairs(folder:GetChildren()) do if child.Name ~= "Origin" then child:Destroy() end end
		end
		plot.signatures = {}
		self.byUser[player.UserId] = nil
		player:SetAttribute("MAMPlotIndex", nil)
	end

	function self:getActivityPosition(player: Player, kind: string, index: number): Vector3?
		local plot = self:getPlot(player)
		if not plot then return nil end
		if kind == "sorting" then return plot.activity.sorting end
		if kind == "watering" or kind == "letters" then return plot.activity[kind][index] end
		return nil
	end

	function self:refresh(player: Player, profile: any, monsters: { any }, visitors: { any })
		local plot = self:getPlot(player)
		if not plot then return end
		local cannonStyle = Catalog.Cannons[profile.cannon] and profile.cannon or "classic"
		local mailboxStyle = Catalog.Mailboxes[profile.mailbox] and profile.mailbox or "classic"
		for _, info in ipairs({ { "cannon", cannonStyle }, { "mailbox", mailboxStyle } }) do
			local kind, style = info[1], info[2]
			if plot[kind]:GetAttribute("Style") ~= style then
				plot[kind]:Destroy()
				local replacement = kind == "cannon" and buildCannon(style) or buildMailbox(style)
				replacement:SetAttribute("MAMPlotIndex", plot.index)
				replacement:PivotTo(plot.frame * CFrame.new(kind == "cannon" and 12 or 0, 0, kind == "mailbox" and -5 or 0))
				replacement.Parent = plot.model
				plot[kind] = replacement
			end
		end
		for i = 1, 8 do
			local key = tostring(i)
			local id = (profile.placements or {})[key]
			if not Catalog.Decorations[id] then id = nil end
			local signatureKey = "anchor" .. key
			if plot.signatures[signatureKey] ~= id then
				local existing = plot.decorations:FindFirstChild(signatureKey)
				if existing then existing:Destroy() end
				if id then
					local model = decorationTemplates[id]:Clone()
					model.Name = signatureKey
					model:PivotTo(plot.frame * CFrame.new(anchorPositions[i]))
					model.Parent = plot.decorations
				end
				plot.signatures[signatureKey] = id
			end
		end
		local displays, displayPerches, used, selected = {}, {}, {}, {}
		for _, id in pairs(profile.displaySlots or {}) do selected[id] = true end
		for perch = 1, 3 do
			local wanted = (profile.displaySlots or {})[tostring(perch)]
			local candidate = nil
			for _, monster in ipairs(monsters or {}) do
				if monster.state == "HOME" and monster.id == wanted and not used[monster.id] then candidate = monster; break end
			end
			if not candidate then
				for _, monster in ipairs(monsters or {}) do
					if monster.state == "HOME" and not used[monster.id] and not selected[monster.id] then candidate = monster; break end
				end
			end
			if candidate then
				table.insert(displays, candidate)
				displayPerches[candidate.id] = perch
				used[candidate.id] = true
			end
		end
		local expected = {}
		for groupIndex, group in ipairs({ displays, visitors or {} }) do
			for i, monster in ipairs(group) do
				if i > 3 then break end
				local renderIndex = if groupIndex == 1 then displayPerches[monster.id] else i
				local key = (groupIndex == 1 and "Home" or "Visitor") .. tostring(renderIndex)
				expected[key] = true
				local signature = renderSignature(monster)
				if plot.signatures[key] ~= signature then
					local old = plot.rendered:FindFirstChild(key)
					if old then old:Destroy() end
					local model = MonsterFactory.create(monster, groupIndex == 1 and 0.82 or 0.55)
					model.Name = key
					local position = groupIndex == 1 and Vector3.new((renderIndex - 2) * 4.8, 0.75, 12) or Vector3.new((i - 2) * 2.2, 0.15, -10)
					model:PivotTo(plot.frame * CFrame.new(position))
					model.Parent = plot.rendered
					label(model.PrimaryPart :: BasePart, tostring(monster.name or "Visitor") .. (groupIndex == 2 and "\nVISITING COURIER CARE" or ""), 140, groupIndex == 2 and 48 or 30, groupIndex == 1 and 4.8 or 3.7)
					prompt(model.PrimaryPart :: BasePart, groupIndex == 1 and "Collection" or "Mailbox", groupIndex == 1 and "Meet monster" or "Open passport", "", tostring(monster.id))
					plot.signatures[key] = signature
				end
			end
		end
		for _, child in ipairs(plot.rendered:GetChildren()) do
			if child.Name ~= "Origin" and not expected[child.Name] then plot.signatures[child.Name] = nil; child:Destroy() end
		end
	end

	function self:destroy()
		if not self.alive then return end
		self.alive = false
		for _, player in ipairs(Players:GetPlayers()) do self:release(player) end
		for _, effect in ipairs(self.lighting) do effect:Destroy() end
		self.decorationTemplates:Destroy()
		self.root:Destroy()
		if activeWorld == self then activeWorld = nil end
	end

	-- One bounded low-frequency task recovers falls. It creates no connections
	-- per render frame and stops when this world is destroyed.
	task.spawn(function()
		while self.alive do
			task.wait(1)
			for _, plot in pairs(self.byUser) do
				local player = plot.owner
				local character = player and player.Character
				local humanoidRoot = character and character:FindFirstChild("HumanoidRootPart")
				if humanoidRoot and humanoidRoot:IsA("BasePart") and (humanoidRoot.Position.Y < -18 or humanoidRoot.Position.Magnitude > 650) then teleportToPlot(player, plot) end
			end
		end
	end)
	activeWorld = self
	return self
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="24">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="25">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">80</float>
      <float name="CameraMinZoomDistance">5</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="26">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="27">
        <Properties>
          <string name="Name">MailAMonster</string>
        </Properties>
        <Item class="LocalScript" referent="28">
          <Properties>
            <string name="Name">Bootstrap</string>
            <string name="Source"><![CDATA[--!strict
local UIController = require(script.Parent.UIController)
local controller = UIController.new()
controller:start()
script.Destroying:Connect(function()
	controller:destroy()
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local Config = require(game:GetService("ReplicatedStorage").MailAMonster.Shared.Config)
local Theme = require(script.Parent.Theme)
local Effects = {}

local function ownPlot(): Instance?
	local world = workspace:FindFirstChild("MailAMonsterWorld")
	local plots = world and world:FindFirstChild("Plots")
	local index = Players.LocalPlayer:GetAttribute("MAMPlotIndex")
	return plots and plots:FindFirstChild("Plot" .. tostring(index))
end

local function cue(name: string, settings: any)
	local id = Config.Audio[name]
	if type(id) ~= "string" or id == "" or (settings.sfxVolume or 0) == 0 then return end
	local sound = Instance.new("Sound")
	sound.SoundId, sound.Volume, sound.Parent = id, settings.sfxVolume, SoundService
	Debris:AddItem(sound, 8)
	sound:Play()
end

function Effects.dispatch(settings: any)
	local plot = ownPlot()
	local cannon = plot and plot:FindFirstChild("Cannon")
	local muzzle = cannon and cannon:FindFirstChild("Muzzle")
	if not (muzzle and muzzle:IsA("BasePart")) then return end
	local barrel = cannon:FindFirstChild("Barrel")
	local reduced = settings and settings.reducedMotion
	cue("Launch", settings or {})
	if barrel and barrel:IsA("BasePart") and not reduced then
		local original = barrel.CFrame
		TweenService:Create(barrel, TweenInfo.new(0.18, Enum.EasingStyle.Back), { CFrame = original - muzzle.CFrame.LookVector * 0.7 }):Play()
		task.delay(0.18, function()
			if barrel.Parent then TweenService:Create(barrel, TweenInfo.new(0.4, Enum.EasingStyle.Bounce), { CFrame = original }):Play() end
		end)
	end
	if not reduced and settings and settings.cameraShake then
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			local original = humanoid.CameraOffset
			TweenService:Create(humanoid, TweenInfo.new(0.08, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 1, true), { CameraOffset = original + Vector3.new(0.12, 0.1, 0) }):Play()
			task.delay(0.2, function() if humanoid.Parent then humanoid.CameraOffset = original end end)
		end
	end
	local parcel = Instance.new("Part")
	parcel.Name = "AcceptedDispatchParcel"
	parcel.Size = Vector3.new(1.9, 1.6, 1.6)
	parcel.Color = Theme.Cream
	parcel.Material = Enum.Material.SmoothPlastic
	parcel.Anchored, parcel.CanCollide, parcel.CanTouch, parcel.CanQuery = true, false, false, false
	parcel.CFrame = muzzle.CFrame
	parcel.Parent = workspace
	Debris:AddItem(parcel, 3)
	if reduced then
		TweenService:Create(parcel, TweenInfo.new(0.45), { Transparency = 1 }):Play()
		return
	end
	local a = Instance.new("Attachment")
	a.Position, a.Parent = Vector3.new(-0.7, 0, 0), parcel
	local b = Instance.new("Attachment")
	b.Position, b.Parent = Vector3.new(0.7, 0, 0), parcel
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a, b
	trail.Color = ColorSequence.new(Theme.Coral, Theme.Sky)
	trail.Lifetime, trail.Parent = 0.6, parcel
	TweenService:Create(parcel, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { Size = Vector3.new(2.2, 1.2, 1.6) }):Play()
	task.delay(0.2, function()
		if not parcel.Parent then return end
		local direction = muzzle.CFrame.LookVector
		TweenService:Create(parcel, TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = parcel.CFrame + direction * 65 + Vector3.new(0, 45, 0),
			Size = Vector3.new(0.4, 0.4, 0.4), Transparency = 1,
		}):Play()
	end)
end

function Effects.mailbox(settings: any)
	cue("Mail", settings or {})
	if settings and settings.reducedMotion then return end
	local plot = ownPlot()
	local mailbox = plot and plot:FindFirstChild("Mailbox")
	if not mailbox then return end
	if not mailbox:IsA("Model") then return end
	local original = mailbox:GetPivot()
	local value = Instance.new("NumberValue")
	local signal = value.Changed:Connect(function(height)
		if mailbox.Parent then mailbox:PivotTo(original + Vector3.new(0, height, 0)) end
	end)
	local tween = TweenService:Create(value, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 1, true), { Value = 0.6 })
	tween.Completed:Once(function()
		signal:Disconnect()
		value:Destroy()
		if mailbox.Parent then mailbox:PivotTo(original) end
	end)
	tween:Play()
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Theme</string>
            <string name="Source"><![CDATA[--!strict
return {
	Cream = Color3.fromRGB(255, 248, 229),
	Paper = Color3.fromRGB(255, 253, 245),
	Ink = Color3.fromRGB(40, 67, 78),
	Muted = Color3.fromRGB(83, 105, 112),
	Teal = Color3.fromRGB(33, 128, 134),
	Coral = Color3.fromRGB(228, 114, 98),
	Lavender = Color3.fromRGB(215, 201, 236),
	Sky = Color3.fromRGB(190, 221, 240),
	Line = Color3.fromRGB(218, 225, 215),
	White = Color3.fromRGB(255, 255, 255),
	Success = Color3.fromRGB(56, 123, 88),
	Danger = Color3.fromRGB(164, 60, 55),
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--!strict
-- All client requests are intents. The server decides custody, costs and rewards.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local Shared = ReplicatedStorage:WaitForChild("MailAMonster"):WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local MonsterFactory = require(Shared.MonsterFactory)
local W = require(script.Parent.Widgets)
local Theme = require(script.Parent.Theme)
local Effects = require(script.Parent.Effects)

local Controller = {}
Controller.__index = Controller

local function count(map: any): number
	local total = 0
	for _ in pairs(map or {}) do total += 1 end
	return total
end

local function duration(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	if seconds >= 3600 then return string.format("%dh %dm", math.floor(seconds / 3600), math.floor(seconds % 3600 / 60)) end
	if seconds >= 60 then return string.format("%dm %ds", math.floor(seconds / 60), seconds % 60) end
	return tostring(seconds) .. "s"
end

local function pretty(value: any): string
	return tostring(value or "Unknown"):gsub("_", " ")
end

local function copyMonster(monster: any, slots: any): any
	local copy = table.clone(monster)
	copy.slots = table.clone(slots or {})
	return copy
end

local function lastBook(monster: any): any
	local books = monster.books or {}
	return books[#books]
end

local function bookById(monster: any, id: string?): any
	for _, book in ipairs(monster.books or {}) do
		if book.id == id then return book end
	end
	return lastBook(monster)
end

local function tutorialText(profile: any): (string, string)
	local t = profile.tutorial or {}
	if t.skipped or t.claimed then return "", "Collection" end
	if not t.hatched then return "1 / 6 · Meet your little monster. Hatch your free egg!", "Hatch" end
	if not t.visitor then return "2 / 6 · Open your mailbox. Give the NPC practice visitor a souvenir and send a smile.", "Mailbox" end
	if not t.activity then return "3 / 6 · Earn Postage! Try a short postal activity on your island.", "Activities" end
	if not t.practice then return "4 / 6 · Launch your monster on a free Practice Voyage. Three fictional NPC stops, about 75 seconds.", "Collection" end
	return "5 / 6 · Watch your monster come home, then claim your welcome decoration.", "Collection"
end

function Controller.new()
	local self: any = setmetatable({}, Controller)
	self.snapshot = nil
	self.route = ""
	self.args = {}
	self.busy = false
	self.clockReceived = os.clock()
	self.connections = {}
	self.renderCleanups = {}
	self.replayGeneration = 0
	self.selectedName = Catalog.Names[1]
	self.selectedSouvenir = Catalog.SouvenirOrder[1]
	self.selectedObjective = "hat"
	self.selectedAnchor = "1"
	self.selectedDecoration = "welcome"
	self.toastGeneration = 0
	self.seenVisitors = {}
	self.photo = false
	self.remotes = ReplicatedStorage.MailAMonster:WaitForChild("Remotes")
	self:_build()
	return self
end

function Controller:now(): number
	return if self.snapshot then (self.snapshot.serverTime or os.time()) + (os.clock() - self.clockReceived) else os.time()
end

function Controller:settings(): any
	return if self.snapshot then self.snapshot.profile.settings or {} else {}
end

function Controller:monster(id: string?): any
	if not self.snapshot then return nil end
	for _, group in ipairs({ self.snapshot.monsters or {}, self.snapshot.visitors or {} }) do
		for _, monster in ipairs(group) do
			if monster.id == id then return monster end
		end
	end
	return nil
end

function Controller:_build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("MailAMonsterUI")
	if old then old:Destroy() end
	self.gui = W.create("ScreenGui", {
		Name = "MailAMonsterUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets, DisplayOrder = 20,
	}, playerGui)
	self.hud = W.create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, self.gui)
	local header = W.create("Frame", { Size = UDim2.new(1, -24, 0, 74), Position = UDim2.fromOffset(12, 6), BackgroundColor3 = Theme.Cream, BorderSizePixel = 0 }, self.hud)
	W.corner(header, 16)
	self.title = W.create("TextLabel", { Size = UDim2.new(0.57, -14, 1, -12), Position = UDim2.fromOffset(14, 6), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 19, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Ink, Text = "MAIL A MONSTER\nLittle monster. Big adventure." }, header)
	self.balance = W.create("TextLabel", { Size = UDim2.new(0.43, -14, 1, -12), Position = UDim2.new(0.57, 0, 0, 6), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 16, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Theme.Teal, Text = "Opening the post office…" }, header)
	self.simulation = W.create("TextLabel", { Size = UDim2.new(1, -24, 0, 34), Position = UDim2.fromOffset(12, 84), BackgroundColor3 = Theme.Lavender, BorderSizePixel = 0, TextSize = 13, Font = Enum.Font.GothamMedium, TextColor3 = Theme.Ink, TextWrapped = true, Visible = false, Text = "Studio simulation — progress is not saved" }, self.hud)
	W.corner(self.simulation, 10)
	self.guidance = W.create("TextButton", { Size = UDim2.new(1, -24, 0, 72), Position = UDim2.fromOffset(12, 122), BackgroundColor3 = Theme.Cream, BorderSizePixel = 0, Font = Enum.Font.GothamMedium, TextSize = 16, TextColor3 = Theme.Ink, TextWrapped = true, Text = "", Visible = false, Selectable = true }, self.hud)
	W.corner(self.guidance)
	W.padding(self.guidance, 10)
	self.guidance.Activated:Connect(function()
		if self.snapshot then local _, route = tutorialText(self.snapshot.profile) self:open(route) end
	end)
	local nav = W.create("ScrollingFrame", { Size = UDim2.new(0.82, 0, 0, 64), Position = UDim2.new(0.5, 0, 1, -12), AnchorPoint = Vector2.new(0.5, 1), BackgroundColor3 = Theme.Cream, BorderSizePixel = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 3 }, self.hud)
	W.corner(nav)
	W.padding(nav, 7)
	W.list(nav, 7, true)
	for _, entry in ipairs({ { "Monsters", "Collection" }, { "Mailbox", "Mailbox" }, { "Activities", "Activities" }, { "Journal", "Album" }, { "Requests", "Requests" }, { "Shop", "Shop" }, { "Decorate", "Decorations" }, { "Settings", "Settings" }, { "Help", "Tutorial" } }) do
		local button = W.button(nav, entry[1], function() self:open(entry[2]) end, true)
		button.Size = UDim2.fromOffset(112, 48)
	end
	self.shade = W.create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Ink, BackgroundTransparency = 0.52, Visible = false, ZIndex = 10, Active = false }, self.gui)
	self.window = W.create("Frame", { Size = UDim2.fromScale(0.94, 0.82), Position = UDim2.fromScale(0.5, 0.48), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.Cream, BorderSizePixel = 0, ZIndex = 11, Visible = false }, self.gui)
	W.corner(self.window, 20)
	W.create("UISizeConstraint", { MaxSize = Vector2.new(850, 900), MinSize = Vector2.new(260, 180) }, self.window)
	self.windowTitle = W.create("TextLabel", { Size = UDim2.new(1, -85, 0, 55), Position = UDim2.fromOffset(18, 0), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.Ink, Font = Enum.Font.GothamBold, TextSize = 22, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left }, self.window)
	local close = W.button(self.window, "×", function() self:close() end, true)
	close.Position, close.Size = UDim2.new(1, -57, 0, 7), UDim2.fromOffset(48, 44)
	self.content = W.create("ScrollingFrame", { Size = UDim2.new(1, -24, 1, -65), Position = UDim2.fromOffset(12, 56), BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = 5, ScrollBarImageColor3 = Theme.Teal }, self.window)
	self.toast = W.create("TextLabel", { Size = UDim2.new(0.9, 0, 0, 88), Position = UDim2.fromScale(0.5, 0.02), AnchorPoint = Vector2.new(0.5, 0), TextWrapped = true, BackgroundColor3 = Theme.Teal, TextColor3 = Theme.White, Font = Enum.Font.GothamMedium, TextSize = 17, BorderSizePixel = 0, Visible = false, ZIndex = 50 }, self.gui)
	W.create("UISizeConstraint", { MaxSize = Vector2.new(700, 100) }, self.toast)
	W.corner(self.toast)
	W.padding(self.toast, 12)
	self.busyLabel = W.create("TextLabel", { Size = UDim2.new(0.7, 0, 0, 48), Position = UDim2.fromScale(0.5, 0.9), AnchorPoint = Vector2.new(0.5, 1), Text = "Waiting for the post office…", TextWrapped = true, BackgroundColor3 = Theme.Lavender, TextColor3 = Theme.Ink, Font = Enum.Font.GothamMedium, TextSize = 17, Visible = false, ZIndex = 45 }, self.gui)
	W.corner(self.busyLabel)
	self.photoExit = W.button(self.gui, "Exit Photo View · B / Esc", function() self:setPhoto(false) end, true)
	self.photoExit.Size, self.photoExit.Position = UDim2.fromOffset(230, 48), UDim2.fromOffset(12, 12)
	self.photoExit.Visible, self.photoExit.ZIndex = false, 60
end

function Controller:notice(message: string, failure: boolean?)
	self.toastGeneration += 1
	local generation = self.toastGeneration
	self.toast.Text, self.toast.BackgroundColor3 = message, if failure then Theme.Danger else Theme.Teal
	self.toast.Visible = true
	task.delay(if failure then 8 else 5, function()
		if self.toastGeneration == generation then self.toast.Visible = false end
	end)
end

function Controller:_hud()
	if not self.snapshot then return end
	local profile = self.snapshot.profile
	self.balance.Text = tostring(profile.currency or 0) .. " Postage\nCourier level " .. tostring(profile.level or Config.level(profile.xp or 0)) .. "  ·  " .. #self.snapshot.visitors .. "/" .. Config.IncomingCapacity .. " visitors"
	self.simulation.Visible = self.snapshot.simulation == true and not self.photo
	local text = tutorialText(profile)
	self.guidance.Text = text
	self.guidance.Position = UDim2.fromOffset(12, if self.snapshot.simulation then 122 else 86)
	self.guidance.Visible = text ~= "" and self.route == "" and not self.photo
end

function Controller:_snapshot(snapshot: any)
	if type(snapshot) ~= "table" or type(snapshot.profile) ~= "table" then return end
	snapshot.monsters, snapshot.visitors = snapshot.monsters or {}, snapshot.visitors or {}
	local hadSnapshot = self.snapshot ~= nil
	self.snapshot, self.clockReceived = snapshot, os.clock()
	for _, visitor in ipairs(snapshot.visitors) do
		if not self.seenVisitors[visitor.id] and hadSnapshot then
			self:notice((if visitor.voyage and visitor.voyage.practice then "NPC practice visitor" else "A visitor") .. " arrived! Open your mailbox.")
			Effects.mailbox(self:settings())
		end
		self.seenVisitors[visitor.id] = true
	end
	self:_hud()
	self:_audio()
end

function Controller:request(action: string, payload: any?, onSuccess: ((any) -> ())?)
	if self.busy then self:notice("Your last request is still being checked. Please wait a moment.") return end
	self.busy, self.busyLabel.Visible = true, true
	task.spawn(function()
		local ok, response = pcall(function() return self.remotes.Request:InvokeServer(action, payload or {}) end)
		self.busy, self.busyLabel.Visible = false, false
		if not ok or type(response) ~= "table" then
			self:notice("The post office could not be reached. Your last accepted progress is safe; tap Retry or try that action again.", true)
			if not self.snapshot then self:open("Connection") end
			return
		end
		if response.data then self:_snapshot(response.data) end
		if response.ok ~= true then
			self:notice(tostring(response.error or "That action could not be completed. Please refresh and try again."), true)
			if not self.snapshot then self:open("Connection") elseif self.route ~= "Replay" then self:render() end
			return
		end
		if onSuccess then onSuccess(response) elseif self.route ~= "Replay" then self:render() end
	end)
end

function Controller:_audio()
	local settings = self:settings()
	if self.music then self.music.Volume = (settings.musicVolume or 0) * 0.3 end
end

function Controller:setPhoto(enabled: boolean)
	self.photo = enabled
	self.hud.Visible = not enabled
	self.window.Visible = not enabled and self.route ~= ""
	self.shade.Visible = not enabled and self.route ~= "" and self.route ~= "Activity"
	self.photoExit.Visible = enabled
	self.toast.Visible = false
	self:_hud()
end

function Controller:close()
	if self.photo then self:setPhoto(false) return end
	self.route, self.args = "", {}
	self.replayGeneration += 1
	self:render()
end

function Controller:open(route: string, args: any?)
	if self.photo then self:setPhoto(false) end
	self.replayGeneration += 1
	self.route, self.args = route, args or {}
	self:render()
end

function Controller:_clear()
	for _, cleanup in ipairs(self.renderCleanups) do cleanup() end
	self.renderCleanups = {}
	self.content:ClearAllChildren()
	W.padding(self.content, 3)
	W.list(self.content, 12)
end

function Controller:render()
	self:_clear()
	self.window.Visible = self.route ~= "" and not self.photo
	self.shade.Visible = self.window.Visible and self.route ~= "Activity"
	self.window.Size = if self.route == "Activity" then UDim2.new(0.9, 0, 0, 350) else UDim2.fromScale(0.94, 0.82)
	self.window.Position = if self.route == "Activity" then UDim2.new(0.5, 0, 0, 8) else UDim2.fromScale(0.5, 0.48)
	self.window.AnchorPoint = if self.route == "Activity" then Vector2.new(0.5, 0) else Vector2.new(0.5, 0.5)
	self:_hud()
	if self.route == "" then return end
	if not self.snapshot then
		self.windowTitle.Text = "Connecting to the post office"
		W.label(self.content, "We are checking your saved progress. If the service is unavailable, progress will not be replaced with a new account.")
		W.button(self.content, "Retry connection", function() self:request("Snapshot", {}, function() self:open("Tutorial") end) end)
		return
	end
	local method = (self :: any)["screen" .. self.route]
	if method then method(self) else self:screenCollection() end
	self.content.CanvasPosition = Vector2.zero
	if UserInputService.GamepadEnabled then
		for _, object in ipairs(self.content:GetDescendants()) do
			if object:IsA("GuiButton") and object.Selectable then GuiService.SelectedObject = object; break end
		end
	end
end

function Controller:screenTutorial()
	self.windowTitle.Text = "Welcome to the postal islands"
	W.label(self.content, Config.Tagline, 22, Theme.Teal)
	local text, route = tutorialText(self.snapshot.profile)
	if text ~= "" then W.button(self.content, text, function() self:open(route) end) end
	for _, instruction in ipairs({
		"1. Hatch a free egg. Pick a name, meet its personality, and explore your island.",
		"2. Open your mailbox. The NPC tutorial visitor is clearly marked. Preview one free souvenir, then forward it from your cannon.",
		"3. Try Parcel Sorting, Flower Watering, or Floating Letters. Follow the marked stations to earn Postage.",
		"4. Send your own monster on a free Practice Voyage. Its three fictional NPC stops take about 75 seconds.",
		"5. Open the homecoming in your collection. Watch or skip the replay, claim your welcome decoration, and decorate your island.",
		"6. A normal voyage costs 20 Postage. Ownership always stays with you. Visitors are temporary guests; giving a souvenir and forwarding is always free.",
	}) do W.label(W.card(self.content), instruction) end
	W.label(self.content, "Move with WASD, thumbstick, or touch controls. Use marked prompts or the bottom menu. M opens your monsters; B opens the mailbox; Esc / controller B closes panels.")
	W.label(self.content, "NPC travel is fictional and never earns human-hop income. If every server is offline, overdue voyages are processed when a server next runs.", 15, Theme.Muted)
	if not self.snapshot.profile.tutorial.skipped and not self.snapshot.profile.tutorial.claimed then
		W.button(self.content, "Skip guidance · keep one-time starter benefits", function()
			self:request("SkipTutorial", {}, function() self:notice("Guidance skipped. Your one-time starter benefits are ready.") self:open("Collection") end)
		end, true)
	end
end

function Controller:screenHatch()
	self.windowTitle.Text = "The hatchery"
	local profile = self.snapshot.profile
	local first = not profile.tutorial.hatched
	W.label(self.content, if first then "Your first egg is free. A new friend is waiting inside!" else "A new random-trait egg costs " .. Config.EggCost .. " earned Postage. All traits are cosmetic.", 20, Theme.Teal)
	W.label(self.content, "Choose a name", 19)
	for _, name in ipairs(Catalog.Names) do
		W.button(self.content, (if self.selectedName == name then "✓ " else "") .. name, function() self.selectedName = name self:render() end, self.selectedName ~= name)
	end
	W.label(W.card(self.content, "Every egg can hatch…"), "Four bodies: Slug, Puff, Sprout, Bean. Six color palettes. Four faces. Curious, Sleepy, Dramatic, or Mischievous personalities. Traits never change earnings.")
	local reason = if (profile.pendingEggs or 0) > 0 then "Previous egg is recovering; refresh shortly" elseif #(profile.owned or self.snapshot.monsters) >= Config.MaxOwnedMonsters then "Collection full" elseif not first and profile.currency < Config.EggCost then "Need " .. (Config.EggCost - profile.currency) .. " more Postage" else nil
	W.button(self.content, if first then "Hatch my free egg" else "Hatch · " .. Config.EggCost .. " Postage", function()
		local oldIds = {}
		for _, monster in ipairs(self.snapshot.monsters) do oldIds[monster.id] = true end
		self:request("Hatch", { name = self.selectedName, sequence = profile.hatchSeq or 0 }, function()
			for _, monster in ipairs(self.snapshot.monsters) do
				if not oldIds[monster.id] then self:open("HatchReveal", { monsterId = monster.id }) return end
			end
			self:open("Collection")
		end)
	end, false, reason)
end

function Controller:screenHatchReveal()
	self.windowTitle.Text = "Special delivery!"
	local monster = self:monster(self.args.monsterId)
	if not monster then self:screenCollection() return end
	local _, model = W.portrait(self.content, monster, 250)
	if model then MonsterFactory.react(model, "happy", self:settings().reducedMotion) end
	W.label(self.content, "Hello, " .. monster.name .. "!", 28, Theme.Teal)
	W.label(self.content, pretty(monster.personality) .. " · " .. pretty(monster.body) .. " · " .. (Catalog.Palettes[monster.palette] and Catalog.Palettes[monster.palette].name or pretty(monster.palette)), 18)
	W.label(self.content, "A little monster with a lifetime of adventures ahead. Its name and ownership stay with you through every voyage.")
	W.pair(self.content, "Meet my visitor", function() self:open("Mailbox") end, "My collection", function() self:open("Collection") end)
end

function Controller:screenCollection()
	self.windowTitle.Text = "Your monster collection"
	local monsters = self.snapshot.monsters
	W.label(self.content, #monsters .. " / " .. Config.MaxOwnedMonsters .. " friends · Permanent ownership, lifetime memories", 16, Theme.Muted)
	W.button(self.content, if not self.snapshot.profile.tutorial.hatched then "Hatch your first friend · FREE" else "Visit hatchery · eggs " .. Config.EggCost .. " Postage", function() self:open("Hatch") end, true)
	if #monsters == 0 then
		W.label(self.content, if (self.snapshot.profile.pendingEggs or 0) > 0 then "Your accepted egg is being safely recovered. Refresh shortly; you do not need to buy it again." else "Your display perches are waiting. Start with your free egg.")
		W.button(self.content, "Refresh collection", function() self:request("Snapshot") end, true)
		return
	end
	for _, monster in ipairs(monsters) do
		local card = W.card(self.content, monster.name)
		W.portrait(card, monster, 155)
		W.label(card, pretty(monster.personality) .. " · " .. (if monster.state == "HOME" then "Home on your island" else "Traveling · " .. pretty(monster.state)), 16)
		W.label(card, (monster.lifetimeHops or 0) .. " lifetime human hops · " .. (monster.voyagesCompleted or 0) .. " completed voyages", 15, Theme.Muted)
		W.label(card, (monster.normalVoyagesCompleted or 0) .. " normal voyages · " .. (monster.practiceVoyagesCompleted or 0) .. " NPC practice voyage", 14, Theme.Muted)
		local pending = nil
		for _, book in ipairs(monster.books or {}) do if not book.claimed then pending = book break end end
		if pending then
			W.button(card, "Open homecoming", function() self:open("Replay", { monsterId = monster.id, bookId = pending.id }) end)
		end
		W.button(card, "Portrait, passport & memories", function() self:open("Monster", { monsterId = monster.id }) end, true)
		if monster.state == "HOME" then W.button(card, "Plan a voyage", function() self:open("Launch", { monsterId = monster.id }) end) end
	end
end

function Controller:screenMonster()
	local monster = self:monster(self.args.monsterId)
	if not monster then self:screenCollection() return end
	self.windowTitle.Text = monster.name .. " · " .. pretty(monster.personality)
	local _, portraitModel = W.portrait(self.content, monster, 230)
	if portraitModel then MonsterFactory.react(portraitModel, "idle", self:settings().reducedMotion) end
	W.label(self.content, "Voyage " .. (monster.voyageNumber or 0) .. " · " .. (monster.lifetimeHops or 0) .. " lifetime human hops · " .. (monster.voyagesCompleted or 0) .. " journeys home")
	W.button(self.content, "Open passport", function() self:open("Passport", { monsterId = monster.id }) end, true)
	if monster.state == "HOME" then
		W.button(self.content, "Plan next voyage", function() self:open("Launch", { monsterId = monster.id }) end)
		W.label(self.content, "Choose a display perch", 20)
		for perch = 1, 3 do
			local selected = (self.snapshot.profile.displaySlots or {})[tostring(perch)] == monster.id
			W.button(self.content, (if selected then "✓ " else "") .. "Display on perch " .. perch, function()
				self:request("Display", { monsterId = monster.id, perch = perch }, function() self:notice(monster.name .. " is on display.") self:render() end)
			end, true)
		end
		W.label(self.content, "Wear an earned souvenir", 20)
		if count(monster.earned) == 0 then W.label(self.content, "Bring home souvenirs to unlock their appearances.", 16, Theme.Muted) end
		for _, id in ipairs(Catalog.SouvenirOrder) do
			if monster.earned and monster.earned[id] then
				local item = Catalog.Souvenirs[id]
				W.button(self.content, item.name .. " · " .. item.slot, function()
					self:request("Equip", { monsterId = monster.id, souvenirId = id }, function() self:notice("Appearance updated on your island.") self:render() end)
				end, true)
			end
		end
	else
		self:_tracking(self.content, monster)
	end
	W.label(self.content, "Recent voyage books", 20)
	if #(monster.books or {}) == 0 then W.label(self.content, "Your first story starts when you launch.", 16, Theme.Muted) end
	for index = #(monster.books or {}), 1, -1 do
		local book = monster.books[index]
		W.button(self.content, "Voyage " .. book.number .. (if book.practice then " · NPC Practice" else " · " .. pretty(book.plan)) .. " · " .. (book.humanHops or 0) .. " human hops", function() self:open("Replay", { monsterId = monster.id, bookId = book.id }) end, true)
	end
	W.button(self.content, "Photo View · hide controls", function() self:setPhoto(true) end, true)
end

function Controller:screenMailbox()
	self.windowTitle.Text = "Your visitor mailbox"
	local visitors = self.snapshot.visitors
	W.label(self.content, #visitors .. " / " .. Config.IncomingCapacity .. " visitor slots · Receiving and forwarding are always free.", 16, Theme.Muted)
	if self:settings().acceptVisitors == false then W.label(self.content, "New visitors are paused in Settings. Existing guests can still be forwarded or returned to the pool.", 17, Theme.Teal) end
	if #visitors == 0 then
		W.label(W.card(self.content, "No visitors just yet"), "Your mailbox will bounce when a traveler arrives. Explore, earn Postage, or send your own monster while you wait.")
		W.button(self.content, "Find an activity", function() self:open("Activities") end)
	elseif #visitors >= Config.IncomingCapacity then
		W.label(self.content, "Your mailbox is full. Forward a visitor to make room. Your own returning monsters always have space.", 16, Theme.Teal)
	end
	for _, monster in ipairs(visitors) do
		local voyage = monster.voyage or {}
		local card = W.card(self.content, monster.name .. (if voyage.practice then " · NPC TUTORIAL VISITOR" else " · Visiting traveler"))
		local _, visitorModel = W.portrait(card, monster, 180)
		if visitorModel then MonsterFactory.react(visitorModel, "startled", self:settings().reducedMotion) end
		W.label(card, "A temporary guest. Its original owner keeps it forever.", 16)
		W.label(card, (voyage.humanHops or 0) .. " human hops · Return in " .. duration((voyage.deadline or self:now()) - self:now()), 15, Theme.Muted)
		W.button(card, "Open parcel & choose souvenir", function() self:open("Visitor", { monsterId = monster.id }) end)
		W.button(card, "Read passport", function() self:open("Passport", { monsterId = monster.id, visitor = true }) end, true)
	end
end

function Controller:screenVisitor()
	local monster = self:monster(self.args.monsterId)
	if not monster or not monster.voyage then self:screenMailbox() return end
	local voyage, profile = monster.voyage, self.snapshot.profile
	self.windowTitle.Text = "A souvenir for " .. monster.name
	W.label(self.content, if voyage.practice then "NPC TUTORIAL VISITOR · A fictional friend learning the postal route." else "A fellow player's visitor · Ownership stays with its original owner.", 18, Theme.Teal)
	local selected = Catalog.Souvenirs[self.selectedSouvenir]
	local slots = table.clone(monster.slots or {})
	if selected and (profile.level or 1) >= selected.level then slots[selected.slot] = selected.id end
	local _, model = W.portrait(self.content, copyMonster(monster, slots), 230)
	if model then MonsterFactory.react(model, "packing", self:settings().reducedMotion) end
	W.label(self.content, "Preview · one gift, always free. Replacing the same visual slot keeps every earlier gift in the passport.", 16, Theme.Muted)
	for _, id in ipairs(Catalog.SouvenirOrder) do
		local souvenir = Catalog.Souvenirs[id]
		W.button(self.content, (if self.selectedSouvenir == id then "✓ " else "") .. souvenir.name .. " · " .. souvenir.slot, function() self.selectedSouvenir = id self:render() end, self.selectedSouvenir ~= id, if profile.level < souvenir.level then "Level " .. souvenir.level else nil)
	end
	local limits = profile.rewardLimits or {}
	if (limits.carrier or 0) >= (limits.carrierLimit or Config.CarrierDailyCap) then
		W.label(self.content, "Daily carrier reward limit reached. You can still forward for free and add to this monster's story.", 17, Theme.Teal)
	else
		W.label(self.content, if voyage.practice then "This NPC tutorial dispatch teaches the loop. It is not a human hop." else "A qualifying human forwarding earns " .. Config.CarrierReward .. " Postage, within your daily limit.", 16, Theme.Muted)
	end
	W.button(self.content, "Attach & fire the cannon · FREE", function()
		self:request("Forward", { monsterId = monster.id, voyageId = voyage.id, version = monster.version, souvenirId = self.selectedSouvenir }, function()
			Effects.dispatch(self:settings())
			self:notice("Souvenir saved. Parcel away! Thanks for sending a smile.")
			self:open("Mailbox")
		end)
	end)
	W.button(self.content, "Read full passport", function() self:open("Passport", { monsterId = monster.id, visitor = true }) end, true)
	W.button(self.content, "Return guest to the courier pool · no reward", function()
		self:request("ReleaseVisitor", { monsterId = monster.id, voyageId = voyage.id, version = monster.version }, function() self:notice("Guest safely returned to the courier pool.") self:open("Mailbox") end)
	end, true, if voyage.tutorial then "Tutorial guest: attach a souvenir" else nil)
end

function Controller:_event(parent: Instance, event: any, index: number)
	local npc = event.kind == "NPC" or event.kind == "npc"
	local card = W.card(parent, string.format("%02d  %s", index, if npc then "NPC · FICTIONAL POSTAL STOP" elseif event.humanHop then "HUMAN COURIER" else pretty(event.kind)))
	W.label(card, event.label or "A new page in the story.", 17)
	if event.souvenirId then
		local item = Catalog.Souvenirs[event.souvenirId]
		W.label(card, "Gift: " .. (if item then item.name else "Souvenir") .. (if item then " · " .. item.slot else ""), 16, Theme.Teal)
	end
	if event.stampId then
		local stamp = Catalog.Stamps[event.stampId]
		W.label(card, "Fictional stamp: " .. (if stamp then stamp.name else pretty(event.stampId)), 15, Theme.Muted)
	end
	if event.country then W.label(card, "Optional courier region: " .. tostring(event.country), 15, Theme.Muted) end
	if event.humanHop then W.label(card, if event.rewardEligible then "Human hop · reward eligible" else "Human hop · no reward credit", 14, Theme.Muted) end
end

function Controller:screenPassport()
	local monster = self:monster(self.args.monsterId)
	if not monster then self:screenCollection() return end
	local voyage = if self.args.bookId then bookById(monster, self.args.bookId) else monster.voyage or lastBook(monster)
	self.windowTitle.Text = monster.name .. "'s passport"
	W.portrait(self.content, monster, 190)
	W.label(self.content, "Voyage " .. (if self.args.bookId and voyage then voyage.number else monster.voyageNumber or 0) .. " · " .. (if self.args.bookId then "Completed memory" else pretty(monster.state)), 21, Theme.Teal)
	if voyage then
		W.label(self.content, (if voyage.practice then "NPC PRACTICE VOYAGE · " else "") .. (voyage.humanHops or 0) .. " human hops", 18)
		if voyage.deadline then W.label(self.content, "Returns in " .. duration(voyage.deadline - self:now()) .. " or at the target of " .. (voyage.hopTarget or 0) .. " human hops.", 16) end
		W.label(self.content, "An illustrated postal story. Fictional island stamps are not an exact real-world route.", 15, Theme.Muted)
		for index, event in ipairs(voyage.events or {}) do self:_event(self.content, event, index) end
	else
		W.label(self.content, "A fresh passport. Its first adventure is waiting!")
	end
	W.button(self.content, if self.args.visitor then "Choose a souvenir" else "Back to monster", function() self:open(if self.args.visitor then "Visitor" else "Monster", { monsterId = monster.id }) end)
end

function Controller:_tracking(parent: Instance, monster: any)
	local voyage = monster.voyage
	if not voyage then W.label(parent, "Your monster is being safely prepared. Refresh shortly.") return end
	local card = W.card(parent, if voyage.practice then "NPC Practice Voyage" else "Out on an adventure")
	local clockLabel = W.label(card, "", 18, Theme.Teal)
	local alive = true
	table.insert(self.renderCleanups, function() alive = false end)
	task.spawn(function()
		while alive and clockLabel.Parent do
			clockLabel.Text = (voyage.humanHops or 0) .. " / " .. (voyage.hopTarget or 0) .. " human hops · " .. duration(voyage.deadline - self:now()) .. " until return"
			task.wait(1)
		end
	end)
	W.label(card, if voyage.practice then "Three unmistakably fictional NPC postal stops. No normal human-hop income." else "Random eligible couriers across the experience. Up to three fictional NPC postcards keep the story moving when human traffic is quiet.", 16)
	local eligibleAt = voyage.startedAt + Config.EarlyReturnSeconds
	W.button(card, "Request early return", function()
		self:request("Recall", { monsterId = monster.id, voyageId = voyage.id }, function() self:notice("Early return accepted. Earned rewards are preserved.") self:open("Collection") end)
	end, true, if self:now() < eligibleAt then "Available in " .. duration(eligibleAt - self:now()) else nil)
	W.button(card, "Refresh tracking", function() self:request("Snapshot") end, true)
end

function Controller:screenVoyages()
	self.windowTitle.Text = "Voyage board"
	W.label(self.content, "Choose a monster from your collection to plan a voyage, or follow an adventure already underway.")
	for _, monster in ipairs(self.snapshot.monsters) do
		local card = W.card(self.content, monster.name)
		if monster.state == "HOME" then
			W.button(card, "Plan voyage", function() self:open("Launch", { monsterId = monster.id }) end)
		else
			self:_tracking(card, monster)
			W.button(card, "Read passport", function() self:open("Passport", { monsterId = monster.id }) end, true)
		end
	end
	if #self.snapshot.monsters == 0 then W.button(self.content, "Hatch your first monster", function() self:open("Hatch") end) end
end

function Controller:screenLaunch()
	local monster = self:monster(self.args.monsterId)
	if not monster then self:screenVoyages() return end
	self.windowTitle.Text = "A big adventure for " .. monster.name
	if monster.state ~= "HOME" then self:_tracking(self.content, monster) return end
	W.portrait(self.content, monster, 180)
	local profile = self.snapshot.profile
	local outgoing = 0
	for _, owned in ipairs(self.snapshot.monsters) do if owned.state ~= "HOME" then outgoing += 1 end end
	local capacity = Config.OutgoingCapacity + (if profile.level >= Config.ExtraOutgoingLevel then 1 else 0)
	W.label(self.content, outgoing .. " / " .. capacity .. " outgoing voyages · A third slot unlocks at level " .. Config.ExtraOutgoingLevel, 16, Theme.Muted)
	W.label(self.content, "Choose a little goal", 21)
	for _, id in ipairs({ "hat", "families" }) do
		local objective = Config.Objectives[id]
		W.button(self.content, (if self.selectedObjective == id then "✓ " else "") .. objective.name, function() self.selectedObjective = id self:render() end, self.selectedObjective ~= id)
	end
	W.label(self.content, Config.Objectives[self.selectedObjective].description .. " Reward: " .. Config.Objectives[self.selectedObjective].reward .. " Postage (normal voyages).", 16, Theme.Muted)
	for _, id in ipairs(Config.PlanOrder) do
		local plan = Config.Plans[id]
		local card = W.card(self.content, plan.name .. (if plan.practice then " · NPC PRACTICE" else ""))
		W.label(card, if plan.practice then "Free once. Three fictional NPC stops, about 75 seconds. No normal hop income." else plan.cost .. " Postage deposit · " .. plan.hops .. " human hops OR " .. duration(plan.seconds) .. ". Deposit refunded at homecoming; eligible human hops add " .. Config.OwnerHopReward .. " each.", 17)
		local reason = if outgoing >= capacity then "Outgoing slots full" elseif profile.level < plan.level then "Unlocks at level " .. plan.level elseif profile.currency < plan.cost then "Need " .. (plan.cost - profile.currency) .. " more Postage" elseif plan.practice and profile.tutorial.practice then "Practice completed" else nil
		W.button(card, "Launch " .. plan.name .. (if plan.cost > 0 then " · " .. plan.cost .. " Postage" else " · FREE"), function()
			self:request("Launch", { monsterId = monster.id, plan = id, objective = self.selectedObjective, version = monster.version }, function()
				Effects.dispatch(self:settings())
				self:notice(monster.name .. " is on the way! Open its passport for updates.")
				self:open("Monster", { monsterId = monster.id })
			end)
		end, false, reason)
	end
end

function Controller:screenReplay()
	local monster = self:monster(self.args.monsterId)
	local book = monster and bookById(monster, self.args.bookId)
	if not monster or not book then self:screenCollection() return end
	self.windowTitle.Text = "Welcome home, " .. monster.name
	W.label(self.content, if book.practice then "NPC PRACTICE MEMORY · Fictional postal islands" else "An illustrated memory · Not an exact geographic route", 16, Theme.Teal)
	local stage = W.card(self.content)
	local portrait, model = W.portrait(stage, copyMonster(monster, book.slotsBefore), 210)
	local caption = W.label(stage, "Packing a little suitcase…", 21)
	local progress = W.label(stage, "Departure", 15, Theme.Muted)
	local routeRow = W.row(stage, 32)
	for index = 1, math.min(8, #(book.events or {}) + 2) do
		local dot = W.create("TextLabel", { Size = UDim2.new(1 / math.min(8, #(book.events or {}) + 2), -8, 1, 0), BackgroundColor3 = Theme.Sky, Text = tostring(index), Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Theme.Ink }, routeRow)
		W.corner(dot, 16)
	end
	local paused = false
	local pauseButton: TextButton
	pauseButton = W.button(self.content, "Pause replay", function() paused = not paused pauseButton.Text = if paused then "Resume replay" else "Pause replay" end, true)
	W.button(self.content, "Skip to homecoming summary", function() self:open("Summary", { monsterId = monster.id, bookId = book.id }) end)
	W.button(self.content, "Always prefer an instant summary · enable Reduced Motion", function()
		self:request("Settings", { key = "reducedMotion", value = true }, function() self:open("Summary", { monsterId = monster.id, bookId = book.id }) end)
	end, true)
	if self:settings().reducedMotion then self:open("Summary", { monsterId = monster.id, bookId = book.id }) return end
	local generation = self.replayGeneration
	local events = book.events or {}
	local frames = { { label = "Departure · A little monster, a big adventure.", slots = table.clone(book.slotsBefore or {}) } }
	local slots = table.clone(book.slotsBefore or {})
	for _, event in ipairs(events) do
		local item = event.souvenirId and Catalog.Souvenirs[event.souvenirId]
		if item then slots[item.slot] = item.id end
		table.insert(frames, { label = (if event.kind == "NPC" then "NPC · " else "") .. (event.label or pretty(event.kind)) .. (if item then "\n+ " .. item.name else ""), slots = table.clone(slots) })
	end
	table.insert(frames, { label = "Home sweet home. Look how far you've come!", slots = book.slotsAfter or slots })
	task.spawn(function()
		for index, frame in ipairs(frames) do
			if self.replayGeneration ~= generation or not caption.Parent then return end
			caption.Text = frame.label
			progress.Text = "Memory " .. index .. " / " .. #frames .. " · " .. (book.humanHops or 0) .. " human hops total"
			if model and model.Parent then MonsterFactory.applySouvenirs(model, frame.slots) MonsterFactory.react(model, if index == #frames then "homecoming" else "happy", false) end
			local elapsed = 0
			while elapsed < 15 / #frames do
				if self.replayGeneration ~= generation or not portrait.Parent then return end
				task.wait(0.1)
				if not paused then elapsed += 0.1 end
			end
		end
		if self.replayGeneration == generation then self:open("Summary", { monsterId = monster.id, bookId = book.id }) end
	end)
end

function Controller:screenSummary()
	local monster = self:monster(self.args.monsterId)
	local book = monster and bookById(monster, self.args.bookId)
	if not monster or not book then self:screenCollection() return end
	self.windowTitle.Text = "A suitcase full of stories"
	local before = W.card(self.content, "Before the adventure")
	W.portrait(before, copyMonster(monster, book.slotsBefore), 165)
	local after = W.card(self.content, "Welcome home, " .. monster.name)
	local _, model = W.portrait(after, copyMonster(monster, book.slotsAfter), 215)
	if model then MonsterFactory.react(model, "homecoming", self:settings().reducedMotion) end
	W.label(after, (if book.practice then "NPC PRACTICE · " else "") .. (book.humanHops or 0) .. " human hops · " .. duration((book.returnedAt or self:now()) - book.startedAt) .. " away", 18)
	local payout = W.card(self.content, "Postage statement")
	W.label(payout, "Dispatch deposit returned: " .. (book.deposit or (if book.practice then 0 else 20)) .. "\nEligible human hops: " .. (book.rewardHops or 0) .. " × " .. Config.OwnerHopReward .. " = " .. ((book.rewardHops or 0) * Config.OwnerHopReward) .. "\nVoyage objective: " .. (book.objectiveReward or 0) .. "\nTotal: " .. (book.payout or 0) .. " Postage", 18)
	W.label(payout, "Rewards are saved once. Replaying a memory never pays again.", 15, Theme.Muted)
	local discoveries = W.card(self.content, "Souvenirs discovered on this journey")
	local seen = {}
	for _, event in ipairs(book.events or {}) do
		if event.souvenirId and not seen[event.souvenirId] then
			seen[event.souvenirId] = true
			local item = Catalog.Souvenirs[event.souvenirId]
			W.label(discoveries, "✓ " .. (if item then item.name else "Souvenir"), 17)
		end
	end
	if count(seen) == 0 then W.label(discoveries, "A quiet trip is still a story. Your dispatch deposit comes home.", 16) end
	if not book.claimed then
		W.button(self.content, if book.practice then "Welcome home · claim starter decoration" else "Welcome home · acknowledge rewards", function()
			self:request("ClaimHomecoming", { monsterId = monster.id, bookId = book.id }, function() self:notice(if book.practice then "Welcome pennant unlocked! Decorate your island." else "Homecoming saved. Welcome back!") self:render() end)
		end)
	else
		W.label(self.content, "✓ Homecoming claimed", 18, Theme.Success)
	end
	W.pair(self.content, "Display & dress up", function() self:open("Monster", { monsterId = monster.id }) end, "Next adventure", function() self:open("Launch", { monsterId = monster.id }) end)
	W.button(self.content, "Replay this memory", function() self:open("Replay", { monsterId = monster.id, bookId = book.id }) end, true)
	W.button(self.content, "Read every passport entry", function() self:open("Passport", { monsterId = monster.id, bookId = book.id }) end, true)
	W.button(self.content, "Photo View · show your island", function() self:setPhoto(true) end, true)
end

function Controller:plot(): Instance?
	local world = workspace:FindFirstChild("MailAMonsterWorld")
	local plots = world and world:FindFirstChild("Plots")
	local index = Players.LocalPlayer:GetAttribute("MAMPlotIndex")
	return plots and plots:FindFirstChild("Plot" .. tostring(index))
end

function Controller:screenActivities()
	self.windowTitle.Text = "A little postal work"
	W.label(self.content, "Short activities earn Postage while your monsters are away. Walk to a marked station on your own island to begin.", 18)
	if self.snapshot.activity then W.button(self.content, "Resume current activity", function() self:open("Activity") end) end
	for _, kind in ipairs({ "sorting", "watering", "letters" }) do
		local activity = Config.Activities[kind]
		local card = W.card(self.content, activity.name)
		W.label(card, (if kind == "sorting" then "Match each parcel's printed shape to Circle, Triangle, or Star. Color is a bonus clue." elseif kind == "watering" then "Follow the numbered flower beds and give each one a patient watering." else "Follow an easy route and collect each numbered floating letter. No difficult jumps.") .. "\nAbout " .. (activity.steps * activity.stepSeconds) .. " seconds · " .. activity.reward .. " Postage", 17)
		W.button(card, "Start " .. activity.name, function()
			self:request("ActivityStart", { kind = kind }, function() self:open("Activity") end)
		end, false, if self.snapshot.activity and self.snapshot.activity.kind ~= kind then "Finish current activity first" else nil)
	end
end

function Controller:_markObjective(activity: any)
	local plot = self:plot()
	if not plot or activity.kind == "sorting" then return end
	for _, part in ipairs(plot:GetDescendants()) do
		if part:IsA("BasePart") and part:GetAttribute("MAMActivity") == activity.kind and part:GetAttribute("MAMIndex") == activity.target then
			local highlight = W.create("Highlight", { Adornee = part, FillColor = Theme.Coral, OutlineColor = Theme.White, FillTransparency = 0.55, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, part)
			local billboard = W.create("BillboardGui", { Adornee = part, Size = UDim2.fromOffset(150, 45), StudsOffsetWorldSpace = Vector3.new(0, 4, 0), AlwaysOnTop = true }, self.gui)
			W.create("TextLabel", { Size = UDim2.fromScale(1, 1), Text = "NEXT · " .. activity.target, TextColor3 = Theme.White, BackgroundColor3 = Theme.Teal, Font = Enum.Font.GothamBold, TextSize = 19 }, billboard)
			table.insert(self.renderCleanups, function() highlight:Destroy() billboard:Destroy() end)
			return
		end
	end
end

function Controller:screenActivity()
	local activity = self.snapshot.activity
	if not activity then self:screenActivities() return end
	local definition = Config.Activities[activity.kind]
	self.windowTitle.Text = definition.name
	W.label(self.content, "Step " .. activity.index .. " / " .. activity.total .. " · " .. activity.reward .. " Postage at completion", 17, Theme.Teal)
	local timer = W.label(self.content, "", 16)
	local baseText = if activity.kind == "watering" then "Water flower bed " .. activity.target elseif activity.kind == "letters" then "Collect floating letter " .. activity.target else ""
	if activity.kind == "sorting" then
		local targetLabel = definition.labels[activity.target] or pretty(activity.target)
		W.label(self.content, "This parcel is marked: " .. targetLabel, 23)
	else
		W.label(self.content, baseText .. ". Follow the highlighted NEXT marker on your island.", 18)
	end
	local buttons = {}
	local function send(target: number)
		self:request("ActivityStep", { sessionId = activity.sessionId, target = target }, function()
			if self.snapshot.activity then self:open("Activity") else self:notice("Activity complete! " .. activity.reward .. " Postage earned. Thank you, courier.") self:open("Activities") end
		end)
	end
	if activity.kind == "sorting" then
		for index, label in ipairs(definition.labels) do
			local button = W.button(self.content, label .. " bin", function() send(index) end)
			table.insert(buttons, { button = button, text = label .. " bin" })
		end
	else
		local button = W.button(self.content, baseText, function() send(activity.target) end)
		table.insert(buttons, { button = button, text = baseText })
	end
	W.label(self.content, "You can close this panel to move, then reopen Activities to resume. The server checks your position and each step's timing.", 14, Theme.Muted)
	self:_markObjective(activity)
	local alive = true
	table.insert(self.renderCleanups, function() alive = false end)
	task.spawn(function()
		while alive and timer.Parent do
			local remaining = activity.readyAt - self:now()
			timer.Text = if remaining > 0 then "Preparing… " .. duration(remaining) else "Ready! Complete this step at its marked station."
			for _, item in ipairs(buttons) do
				item.button.Active, item.button.Selectable, item.button.AutoButtonColor = remaining <= 0, remaining <= 0, remaining <= 0
				item.button.BackgroundColor3 = if remaining > 0 then Theme.Line else Theme.Teal
				item.button.TextColor3 = if remaining > 0 then Theme.Ink else Theme.White
				item.button.Text = item.text .. (if remaining > 0 then " · " .. duration(remaining) else "")
			end
			task.wait(0.25)
		end
	end)
end

function Controller:screenRequests()
	self.windowTitle.Text = "Today's postal requests"
	W.label(self.content, "Three daily requests, with an activity alternative for every one. New requests arrive each UTC day. No streaks and no missed-day penalties.", 17)
	local requests = self.snapshot.profile.daily or {}
	if #requests == 0 then W.label(self.content, "Today's request board is loading. Refresh in a moment.") end
	for _, request in ipairs(requests) do
		local card = W.card(self.content, request.title or request.name or request.id)
		W.label(card, request.description or "Help the postal islands.", 17)
		W.label(card, tostring(request.progressA or 0) .. " / " .. tostring(request.targetA or 1) .. "  OR  " .. tostring(request.progressB or 0) .. " / " .. tostring(request.targetB or 1) .. "\nReward: " .. tostring(request.reward or Config.RequestPostage) .. " Postage", 18, Theme.Teal)
		W.button(card, if request.claimed then "✓ Reward claimed" else "Claim request reward", function() self:request("ClaimRequest", { requestId = request.id }, function() self:notice("Request reward saved. Thanks for helping!") self:render() end) end, false, if request.claimed then "Complete" elseif not request.complete then "Finish either objective" else nil)
	end
	local limits = self.snapshot.profile.rewardLimits or {}
	local card = W.card(self.content, "Daily hop reward limits")
	W.label(card, "Carrier rewards: " .. (limits.carrier or 0) .. " / " .. (limits.carrierLimit or Config.CarrierDailyCap) .. " handoffs\nOwner hop bonuses: " .. (limits.owner or 0) .. " / " .. (limits.ownerLimit or Config.OwnerDailyHopCap) .. " credited hops", 17)
	W.label(card, "Historical human hops keep counting after these reward limits. NPC stories and automatic forwarding never earn normal hop income.", 15, Theme.Muted)
	W.button(self.content, "Refresh request board", function() self:request("Snapshot") end, true)
end

function Controller:screenAlbum()
	self.windowTitle.Text = "The souvenir journal"
	local profile = self.snapshot.profile
	W.label(self.content, count(profile.album) .. " / " .. #Catalog.SouvenirOrder .. " souvenirs · " .. count(profile.stamps) .. " / " .. #Catalog.StampOrder .. " fictional stamps", 18, Theme.Teal)
	W.label(self.content, "Discover designs through your deliveries and homecomings. Every stamp below belongs to a fictional postal island.", 16, Theme.Muted)
	for _, milestone in ipairs(Config.Milestones) do
		local progress = count(profile[milestone.stat])
		local claimed = (profile.milestones or {})[milestone.id] == true
		local item = Catalog.Shop[milestone.cosmetic]
		local card = W.card(self.content, milestone.name)
		W.label(card, math.min(progress, milestone.target) .. " / " .. milestone.target .. " · Reward: " .. item.name .. " + " .. milestone.xp .. " courier XP", 16)
		W.button(card, if claimed then "✓ Collection reward claimed" else "Claim collection reward", function()
			self:request("ClaimMilestone", { milestoneId = milestone.id }, function() self:notice("Collection reward saved. A little more color for your island!") self:render() end)
		end, false, if claimed then "Complete" elseif progress < milestone.target then "Keep collecting" else nil)
	end
	for _, id in ipairs(Catalog.SouvenirOrder) do
		local item, context = Catalog.Souvenirs[id], (profile.album or {})[id]
		local card = W.card(self.content, (if context then "✓ " else "? ") .. item.name)
		W.label(card, item.slot .. " · Free courier choice at level " .. item.level .. "\n" .. item.description, 16)
		W.button(card, if context then "View discovery" else "Undiscovered · view design", function() self:open("Discovery", { itemId = id, kind = "souvenir" }) end, true)
	end
	W.label(self.content, "Fictional postal stamps", 22)
	for _, id in ipairs(Catalog.StampOrder) do
		local item, context = Catalog.Stamps[id], (profile.stamps or {})[id]
		W.button(self.content, (if context then "✓ " else "? ") .. "[" .. item.symbol .. "] " .. item.name, function() self:open("Discovery", { itemId = id, kind = "stamp" }) end, true)
	end
end

function Controller:screenDiscovery()
	local stamp = self.args.kind == "stamp"
	local item = (if stamp then Catalog.Stamps else Catalog.Souvenirs)[self.args.itemId]
	if not item then self:screenAlbum() return end
	self.windowTitle.Text = item.name
	local record = (if stamp then self.snapshot.profile.stamps else self.snapshot.profile.album) or {}
	local context = record[item.id]
	if stamp then
		local card = W.card(self.content, "[ " .. item.symbol .. " ]")
		W.label(card, item.name .. "\nFictional postal destination", 28, Theme.Teal)
	else
		local monster = self.snapshot.monsters[1] or { name = "A little preview", body = Catalog.Bodies[1], palette = Catalog.PaletteOrder[1], face = Catalog.Faces[1], personality = "Curious", seed = 1 }
		W.portrait(self.content, copyMonster(monster, { [item.slot] = item.id }), 230)
		W.label(self.content, item.description, 21)
		W.label(self.content, item.slot .. " · Unlocks as a free courier choice at level " .. item.level, 16, Theme.Muted)
	end
	if context then
		W.label(self.content, "✓ Discovered through real gameplay", 19, Theme.Success)
		W.label(self.content, if type(context) == "table" then tostring(context.context or context.label or "A voyage memory") else "A voyage memory", 18)
		if type(context) == "table" and type(context.at) == "number" then W.label(self.content, "Recorded " .. os.date("!%Y-%m-%d", context.at) .. " UTC", 15, Theme.Muted) end
	else W.label(self.content, "Not discovered yet. Send a monster on an adventure or help a visitor to add it to your journal.", 18) end
	W.button(self.content, "Back to journal", function() self:open("Album") end, true)
end

function Controller:_assetPreview(parent: Instance, id: string)
	local assets = ReplicatedStorage.MailAMonster:FindFirstChild("Assets")
	local decorations = assets and assets:FindFirstChild("Decorations")
	local template = decorations and (decorations:FindFirstChild(id) or decorations:FindFirstChild("Decoration_" .. id))
	if not template or not template:IsA("Model") then return end
	local viewport = W.create("ViewportFrame", { Size = UDim2.new(1, 0, 0, 190), BackgroundColor3 = Theme.Sky, BorderSizePixel = 0, Ambient = Color3.fromRGB(205, 205, 205), LightColor = Theme.White, LightDirection = Vector3.new(-1, -1, -1) }, parent)
	W.corner(viewport)
	local world = W.create("WorldModel", {}, viewport)
	local model = template:Clone()
	model:PivotTo(CFrame.new())
	model.Parent = world
	local box, size = model:GetBoundingBox()
	local target = box.Position
	local distance = math.max(7, math.max(size.X, size.Y, size.Z) * 2)
	local camera = W.create("Camera", { CFrame = CFrame.lookAt(target + Vector3.new(distance * 0.7, distance * 0.45, -distance), target), FieldOfView = 35 }, viewport)
	viewport.CurrentCamera = camera
end

function Controller:screenShop()
	self.windowTitle.Text = "The cozy cosmetic shop"
	local profile = self.snapshot.profile
	W.label(self.content, profile.currency .. " Postage · Cosmetics are purchased with earned Postage.", 20, Theme.Teal)
	W.label(self.content, "Decorations and finishes change your island's look. Courier levels unlock choices, never matching priority or earnings.", 16)
	local ids = {}
	for id in pairs(Catalog.Shop) do table.insert(ids, id) end
	table.sort(ids, function(a, b) if Catalog.Shop[a].cost ~= Catalog.Shop[b].cost then return Catalog.Shop[a].cost < Catalog.Shop[b].cost end return a < b end)
	for _, id in ipairs(ids) do
		local item = Catalog.Shop[id]
		local owned = profile.cosmetics and profile.cosmetics[id] == true
		local card = W.card(self.content, item.name)
		if item.kind == "decoration" then self:_assetPreview(card, item.assetId) end
		W.label(card, pretty(item.kind) .. " · " .. item.cost .. " Postage · Level " .. item.level, 16, Theme.Muted)
		if owned then
			W.label(card, "✓ Owned", 17, Theme.Success)
			W.button(card, if item.kind == "decoration" then "Choose a display anchor" else "Use this " .. item.kind .. " style", function()
				if item.kind == "decoration" then self.selectedDecoration = item.assetId self:open("Decorations")
				else self:request("Style", { kind = item.kind, itemId = item.assetId }, function() self:notice("Your " .. item.kind .. " style is ready.") self:render() end) end
			end, true)
		else
			local reason = if profile.level < item.level then "Level " .. item.level elseif profile.currency < item.cost then "Need " .. (item.cost - profile.currency) .. " more Postage" else nil
			W.button(card, "Buy · " .. item.cost .. " Postage", function() self:request("Buy", { itemId = id }, function() self:notice(item.name .. " added to your cosmetics.") self:render() end) end, false, reason)
		end
	end
end

function Controller:_decorationGhost(id: string, anchorId: string)
	local plot = self:plot()
	local anchors = plot and plot:FindFirstChild("DecorationAnchors")
	local anchor = anchors and anchors:FindFirstChild("Anchor" .. anchorId)
	local assets = ReplicatedStorage.MailAMonster:FindFirstChild("Assets")
	local decorations = assets and assets:FindFirstChild("Decorations")
	local template = decorations and (decorations:FindFirstChild(id) or decorations:FindFirstChild("Decoration_" .. id))
	if not anchor or not anchor:IsA("BasePart") or not template or not template:IsA("Model") then return end
	local ghost = template:Clone()
	ghost.Name = "LocalDecorationPreview"
	for _, part in ipairs(ghost:GetDescendants()) do
		if part:IsA("BasePart") then part.Transparency = math.max(part.Transparency, 0.45) part.CanCollide, part.CanTouch, part.CanQuery = false, false, false end
	end
	ghost:PivotTo(CFrame.new(anchor.Position))
	ghost.Parent = workspace
	table.insert(self.renderCleanups, function() ghost:Destroy() end)
end

function Controller:screenDecorations()
	self.windowTitle.Text = "Make your island feel like home"
	local profile = self.snapshot.profile
	W.label(self.content, "Choose one of your island's eight fixed anchors, preview an owned decoration, then place or replace it. Only you can edit your island.", 17)
	W.label(self.content, "1. Choose an anchor", 21)
	for index = 1, Config.AnchorCount do
		local id = tostring(index)
		local installed = (profile.placements or {})[id]
		local definition = installed and Catalog.Decorations[installed]
		W.button(self.content, (if id == self.selectedAnchor then "✓ " else "") .. "Anchor " .. id .. " · " .. (if definition then definition.name else "Empty"), function() self.selectedAnchor = id self:render() end, id ~= self.selectedAnchor)
	end
	W.label(self.content, "2. Choose a decoration", 21)
	local owned = {}
	for _, id in ipairs(Catalog.DecorationOrder) do if (profile.cosmetics or {})["decor:" .. id] then table.insert(owned, id) end end
	if #owned == 0 then
		W.label(self.content, "Finish your Practice Voyage for a welcome pennant, or visit the cosmetic shop.")
		W.button(self.content, "Visit cosmetic shop", function() self:open("Shop") end)
		return
	end
	if not (profile.cosmetics or {})["decor:" .. self.selectedDecoration] then self.selectedDecoration = owned[1] end
	for _, id in ipairs(owned) do
		W.button(self.content, (if id == self.selectedDecoration then "✓ " else "") .. Catalog.Decorations[id].name, function() self.selectedDecoration = id self:render() end, id ~= self.selectedDecoration)
	end
	local preview = W.card(self.content, "Preview · " .. Catalog.Decorations[self.selectedDecoration].name)
	self:_assetPreview(preview, self.selectedDecoration)
	W.label(preview, "The translucent preview marks anchor " .. self.selectedAnchor .. " on your island. Save it below.", 16)
	self:_decorationGhost(self.selectedDecoration, self.selectedAnchor)
	W.button(self.content, "Place / replace at anchor " .. self.selectedAnchor, function()
		self:request("Place", { anchor = self.selectedAnchor, itemId = self.selectedDecoration }, function() self:notice("Decoration saved on your island.") self:render() end)
	end)
	W.button(self.content, "Remove decoration at anchor " .. self.selectedAnchor, function()
		self:request("Place", { anchor = self.selectedAnchor, itemId = "" }, function() self:notice("Anchor cleared. You still own the decoration.") self:render() end)
	end, true, if not (profile.placements or {})[self.selectedAnchor] then "Already empty" else nil)
end

function Controller:screenSettings()
	self.windowTitle.Text = "A comfortable little adventure"
	local settings = self:settings()
	for _, entry in ipairs({
		{ "reducedMotion", "Reduced motion", "Use instant homecoming summaries and gentle visual feedback." },
		{ "cameraShake", "Cannon camera shake", "Optional movement for accepted cannon launches. Reduced motion takes priority." },
		{ "shareCountry", "Share a coarse country / region stamp", "Opt in to a broad region code obtained by Roblox on the server. No precise location; sharing is optional and never affects rewards." },
		{ "acceptVisitors", "Accept new visitors", "Turning this off pauses new assignments. Existing guests remain forwardable or can be returned to the pool." },
	}) do
		local key, title, description = entry[1], entry[2], entry[3]
		local card = W.card(self.content, title)
		W.label(card, description, 16)
		W.button(card, if settings[key] then "ON · tap to turn off" else "OFF · tap to turn on", function() self:request("Settings", { key = key, value = not settings[key] }) end, not settings[key])
	end
	for _, entry in ipairs({ { "musicVolume", "Music volume" }, { "sfxVolume", "Sound effects volume" } }) do
		local key, title = entry[1], entry[2]
		local card = W.card(self.content, title .. " · " .. math.floor((settings[key] or 0) * 100) .. "%")
		for _, level in ipairs({ 0, 0.5, 1 }) do
			W.button(card, (if level == 0 then "Mute" else tostring(level * 100) .. "%"), function() self:request("Settings", { key = key, value = level }) end, (settings[key] or 0) ~= level)
		end
	end
	W.label(self.content, "This build uses visual cues for every important event. Optional music and effects stay silent until permitted audio is configured.", 15, Theme.Muted)
	W.button(self.content, "Photo View · hide normal HUD", function() self:setPhoto(true) end, true)
end

function Controller:_prompt(prompt: ProximityPrompt)
	local action = prompt:GetAttribute("MAMAction")
	if type(action) ~= "string" then return end
	local kind, target = prompt:GetAttribute("MAMKind"), prompt:GetAttribute("MAMTarget")
	if action == "ActivityStart" and type(kind) == "string" then
		self:request("ActivityStart", { kind = kind }, function() self:open("Activity") end)
	elseif action == "Decorations" then
		if type(target) == "string" then self.selectedAnchor = target end
		self:open("Decorations")
	elseif action == "Launch" then
		self:open("Voyages")
	elseif action == "Collection" and type(target) == "string" and self:monster(target) then
		self:open("Monster", { monsterId = target })
	elseif action == "Mailbox" and type(target) == "string" and self:monster(target) then
		self:open("Visitor", { monsterId = target })
	else self:open(action) end
end

function Controller:start()
	table.insert(self.connections, self.remotes.Update.OnClientEvent:Connect(function(snapshot)
		local old = self.snapshot
		self:_snapshot(snapshot)
		if not self.snapshot or self.busy or self.route == "Replay" then return end
		local changed = not old or #old.visitors ~= #self.snapshot.visitors or #old.monsters ~= #self.snapshot.monsters
		if old then
			if old.profile.currency ~= self.snapshot.profile.currency or old.profile.xp ~= self.snapshot.profile.xp
				or (old.profile.requests and old.profile.requests.day) ~= (self.snapshot.profile.requests and self.snapshot.profile.requests.day) then changed = true end
			for index, monster in ipairs(self.snapshot.monsters) do
				local previous = old.monsters[index]
				if not previous or previous.version ~= monster.version or previous.state ~= monster.state then changed = true end
				if previous and (previous.voyage and previous.voyage.rewardHops) ~= (monster.voyage and monster.voyage.rewardHops) then changed = true end
				if previous and previous.state ~= "HOME" and monster.state == "HOME" then self:notice(monster.name .. " is home! Open your collection for a homecoming replay.") end
			end
			if (old.activity and old.activity.index) ~= (self.snapshot.activity and self.snapshot.activity.index) then changed = true end
		end
		if changed and self.route ~= "" then self:render() end
	end))
	table.insert(self.connections, ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if player == nil or player == Players.LocalPlayer then self:_prompt(prompt) end
	end))
	ContextActionService:BindAction("MAMClosePanel", function(_, state)
		if state == Enum.UserInputState.Begin and (self.route ~= "" or self.photo) then self:close() return Enum.ContextActionResult.Sink end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Escape, Enum.KeyCode.ButtonB)
	ContextActionService:BindAction("MAMMonsters", function(_, state)
		if state == Enum.UserInputState.Begin then self:open("Collection") end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.M)
	ContextActionService:BindAction("MAMMailbox", function(_, state)
		if state == Enum.UserInputState.Begin then self:open("Mailbox") end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.B)
	if Config.Audio.Music ~= "" then
		self.music = W.create("Sound", { Name = "PostalIslandMusic", SoundId = Config.Audio.Music, Looped = true, Volume = 0 }, SoundService)
		self.music:Play()
	end
	self:open("Connection")
	self:request("Snapshot", {}, function()
		local text = tutorialText(self.snapshot.profile)
		if text ~= "" then self:open("Tutorial") else self:close() end
	end)
end

function Controller:destroy()
	self.replayGeneration += 1
	for _, connection in ipairs(self.connections) do connection:Disconnect() end
	for _, cleanup in ipairs(self.renderCleanups) do cleanup() end
	for _, name in ipairs({ "MAMClosePanel", "MAMMonsters", "MAMMailbox" }) do ContextActionService:UnbindAction(name) end
	if self.music then self.music:Destroy() end
	self.gui:Destroy()
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Widgets</string>
            <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Theme = require(script.Parent.Theme)
local MonsterFactory = require(ReplicatedStorage:WaitForChild("MailAMonster"):WaitForChild("Shared"):WaitForChild("MonsterFactory"))

local Widgets = {}

function Widgets.create(className: string, properties: {[string]: any}, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in pairs(properties) do
		(instance :: any)[key] = value
	end
	instance.Parent = parent
	return instance
end

function Widgets.corner(parent: Instance, radius: number?)
	Widgets.create("UICorner", { CornerRadius = UDim.new(0, radius or 14) }, parent)
end

function Widgets.padding(parent: Instance, pixels: number)
	Widgets.create("UIPadding", {
		PaddingTop = UDim.new(0, pixels), PaddingBottom = UDim.new(0, pixels),
		PaddingLeft = UDim.new(0, pixels), PaddingRight = UDim.new(0, pixels),
	}, parent)
end

function Widgets.list(parent: Instance, gap: number?, horizontal: boolean?)
	return Widgets.create("UIListLayout", {
		Padding = UDim.new(0, gap or 10), SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
	}, parent)
end

function Widgets.label(parent: Instance, value: string, size: number?, color: Color3?): TextLabel
	return Widgets.create("TextLabel", {
		Name = "Text", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Text = value, TextSize = size or 17,
		Font = Enum.Font.GothamMedium, TextColor3 = color or Theme.Ink,
		TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, parent)
end

function Widgets.button(parent: Instance, value: string, callback: (() -> ())?, secondary: boolean?, disabledReason: string?): TextButton
	local button = Widgets.create("TextButton", {
		Name = "Button", Size = UDim2.new(1, 0, 0, 48), TextWrapped = true,
		Text = if disabledReason then value .. " · " .. disabledReason else value,
		Font = Enum.Font.GothamMedium, TextSize = 16,
		TextColor3 = if secondary or disabledReason then Theme.Ink else Theme.White,
		BackgroundColor3 = if disabledReason then Theme.Line elseif secondary then Theme.Sky else Theme.Teal,
		AutoButtonColor = disabledReason == nil, Selectable = disabledReason == nil,
		Active = disabledReason == nil,
	}, parent)
	Widgets.corner(button, 12)
	Widgets.padding(button, 6)
	if callback and not disabledReason then
		button.Activated:Connect(callback)
	end
	return button
end

function Widgets.card(parent: Instance, heading: string?): Frame
	local frame = Widgets.create("Frame", {
		Name = "Card", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Paper, BorderSizePixel = 0,
	}, parent)
	Widgets.corner(frame)
	Widgets.padding(frame, 14)
	Widgets.list(frame, 10)
	if heading then Widgets.label(frame, heading, 21) end
	return frame
end

function Widgets.row(parent: Instance, height: number?): Frame
	local frame = Widgets.create("Frame", {
		Size = UDim2.new(1, 0, 0, height or 48), BackgroundTransparency = 1,
	}, parent)
	Widgets.list(frame, 8, true)
	return frame
end

function Widgets.pair(parent: Instance, leftText: string, leftAction: () -> (), rightText: string, rightAction: () -> ())
	local row = Widgets.row(parent)
	local left = Widgets.button(row, leftText, leftAction)
	left.Size = UDim2.new(0.5, -4, 1, 0)
	local right = Widgets.button(row, rightText, rightAction, true)
	right.Size = UDim2.new(0.5, -4, 1, 0)
	return row
end

function Widgets.portrait(parent: Instance, monster: any, size: number?): (ViewportFrame, Model?)
	local viewport = Widgets.create("ViewportFrame", {
		Name = "MonsterPortrait", Size = UDim2.new(1, 0, 0, size or 180),
		BackgroundColor3 = Theme.Lavender, BorderSizePixel = 0,
		Ambient = Color3.fromRGB(205, 205, 205), LightColor = Color3.fromRGB(255, 248, 222),
		LightDirection = Vector3.new(-1, -1, -1),
	}, parent)
	Widgets.corner(viewport, 16)
	local world = Widgets.create("WorldModel", {}, viewport)
	local success, model = pcall(MonsterFactory.create, monster, 1)
	if not success then
		Widgets.label(viewport, monster.name or "Little monster", 20)
		warn("MAIL A MONSTER portrait unavailable", model)
		return viewport, nil
	end
	model.Parent = world
	local camera = Widgets.create("Camera", { FieldOfView = 32, CFrame = CFrame.lookAt(Vector3.new(7, 5, -13), Vector3.new(0, 2.5, 0)) }, viewport)
	viewport.CurrentCamera = camera
	return viewport, model
end

return Widgets
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="33">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-150</float>
      <float name="Gravity">150</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>